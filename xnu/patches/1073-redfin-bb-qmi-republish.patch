@@ -2592,6 +2765,31 @@ sweet_qmux_qrtr(const struct sbb_qrtr_hdr *h, const uint8_t *d, uint32_t n)
 			}
 			o = strip_tlvs(x->svc, x->ind_msg, t, o);
