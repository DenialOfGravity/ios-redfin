+static void
+d_handle_add(struct cl *c, uint32_t hd)
+{
+	struct dcl *x = d_of(c);
+	for (int i = 0; i < x->nh; i++) {
+		if (x->h[i] == hd) {
+			return;
+		}
+	}
+	if (x->nh < D_NH) {
+		x->h[x->nh++] = hd;
+	} else {
+		LOG("data: %s/%u WDS cid %u: more than %d live handles, 0x%x not tracked\n", pipe_name[c->pipe], c->sess, c->cid, D_NH, hd);
+	}
