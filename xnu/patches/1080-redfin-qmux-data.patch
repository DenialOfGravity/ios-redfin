+static void
+d_gw_known(struct cl *c, uint32_t gw_be, const char *src)
+{
+	struct dcl *x = d_of(c);
+	char a[20];
+	x->gw_state = 3;
+	if (!x->mux || !gw_be) {
+		return;
+	}
+	ip4s(a, sizeof(a), gw_be);
+	if (D->mx[x->mux].gw != gw_be) {
+		LOG("data: mux %u IPv4 gateway %s (%s)\n", x->mux, a, src);
+	}
+	D->mx[x->mux].gw = gw_be;
+	if (D->mx[x->mux].up) {
+		sweet_ipa_call(x->mux, 1, gw_be);
+	}
