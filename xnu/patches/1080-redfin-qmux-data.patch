+
+static int
+d_handle_del(struct dcl *x, uint32_t hd)
+{
+	for (int i = 0; i < x->nh; i++) {
+		if (x->h[i] == hd) {
+			x->h[i] = x->h[--x->nh];
+			return 1;
+		}
+	}
+	return 0;
