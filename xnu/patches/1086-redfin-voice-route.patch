+		gain_applied = 0xffffffffu;     /* tried again at the next period */
+		return;
+	}
+	SAY("ADC1 gain %u -> %u (%s)\n", gain_applied == 0xffffffffu ? 0 : gain_applied, g,
+	    voice_wants ? "kern.sweet_voice_gain_tx" : "micgain");
+	gain_applied = g;
+}
