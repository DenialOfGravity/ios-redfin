+void
+AppleARMBacklight::publishTrueTone(void)
+{
+	if (!(sweet_bl_fix & 32)) {
+		if (getProperty("default-whitepoint-type") != NULL) {
+			removeProperty("default-whitepoint-type");
+		}
+		if (getProperty("truetone-strength") != NULL) {
+			removeProperty("truetone-strength");
+		}
+		return;
+	}
+	uint32_t wp = 1;
+	static const uint32_t tt[3] = { 0x010e0000u, 0x00c8010eu, 0x00c800c8u };
+	OSData *wpd = OSData::withBytes(&wp, sizeof(wp));
+	OSData *ttd = OSData::withBytes(tt, sizeof(tt));
+	if (wpd != NULL) {
+		setProperty("default-whitepoint-type", wpd);
+		wpd->release();
+	}
+	if (ttd != NULL) {
+		setProperty("truetone-strength", ttd);
+		ttd->release();
+	}
+	IOLog("SWEET BL: 1298 True Tone properties published (kern.sweet_bl_fix & 32)\n");
