+/* 1298: build IEEE-754 binary64 from signed fixed-point val / 2^frac using integer math only. */
+static double
+sweet_q2d(int64_t val, int frac)
+{
+	union { uint64_t u; double d; } out;
+	if (val == 0) {
+		out.u = 0;
+		return out.d;
+	}
+	uint64_t sign = 0;
+	uint64_t mag;
+	if (val < 0) {
+		sign = 1ULL << 63;
+		mag = (uint64_t)(-(val + 1)) + 1ULL;
+	} else {
+		mag = (uint64_t)val;
+	}
+	int msb = 63 - __builtin_clzll(mag);
+	int exp = 1023 + msb - frac;
+	if (exp <= 0) {
+		out.u = 0;
+		return out.d;
+	}
+	if (exp >= 2047) {
+		out.u = sign | (0x7ffULL << 52);
+		return out.d;
+	}
+	uint64_t mant;
+	if (msb >= 52) {
+		mant = (mag >> (msb - 52)) & ((1ULL << 52) - 1ULL);
+	} else {
+		mant = (mag << (52 - msb)) & ((1ULL << 52) - 1ULL);
+	}
+	out.u = sign | ((uint64_t)exp << 52) | mant;
+	return out.d;
+}
+
+/* 1298: CCT (K) -> CIE 1931 (x, y) in Q16 (Kang et al. 2002); used when only CCT is provided. */
+static void
+sweet_cct_to_xy(int64_t t, int64_t *xq16, int64_t *yq16)
+{
+	if (t < 1667) {
+		t = 1667;
+	} else if (t > 25000) {
+		t = 25000;
+	}
+	int64_t t2 = t * t, t3 = t2 * t;
+	int64_t x;
+	if (t <= 4000) {
+		x = (-266123900LL << 16) / t3 - (234358900LL << 6) / t2 * 1024LL / 1000LL +
+		    (877696LL << 16) / (1000LL * t) + 11791;
+	} else {
+		x = (-3025846900LL << 16) / t3 + (2107037900LL << 6) / t2 * 1024LL / 1000LL +
+		    (222635LL << 16) / (1000LL * t) + 15754;
+	}
+	int64_t x2 = (x * x) >> 16;
+	int64_t x3 = (x2 * x) >> 16;
+	int64_t y;
+	if (t <= 2222) {
+		y = ((-72508LL * x3 - 88350LL * x2 + 143233LL * x) >> 16) - 13251;
+	} else if (t <= 4000) {
+		y = ((-62583LL * x3 - 90059LL * x2 + 137060LL * x) >> 16) - 10977;
+	} else {
+		y = ((201966LL * x3 - 384918LL * x2 + 245834LL * x) >> 16) - 24249;
+	}
+	*xq16 = x < 655 ? 655 : (x > 64000 ? 64000 : x);
+	*yq16 = y < 655 ? 655 : (y > 64000 ? 64000 : y);
+}
+
+/*
+ * 1298: compute CoreBrightness CIE XYZ * pi components (Q16) and CCT (K) from TCS3701 RGB or CCT.
+ * CoreBrightness CBALSEvent divides kIOHIDEventFieldAmbientLightColorComponent0..2 by pi (0x1af14b470),
+ * checks c0 != 0 && c1 != 0, and computes x = X/(X+Y+Z), y = Y/(X+Y+Z).
+ */
+static void
+sweet_als_xyz(const struct sweet_motion_sample *s, int64_t lux_q16,
+    int64_t *c0_q16, int64_t *c1_q16, int64_t *c2_q16, int64_t *cct_out)
+{
+	int64_t xu = 62290, yu = 65536, zu = 71357; /* D65 default (0.95047, 1.0, 1.08883) in Q16 */
+	int64_t cct = 6500;
+	bool has_rgb = (s->flags & SWEET_MOTION_ALS_RGB) || (s->v[2] != 0 || s->v[3] != 0);
+
+	if (has_rgb) {
+		int64_t r = sweet_f2q(s->v[1], 1, 1, 8);
+		int64_t g = sweet_f2q(s->v[2], 1, 1, 8);
+		int64_t b = sweet_f2q(s->v[3], 1, 1, 8);
+		if (r < 0) r = 0;
+		if (g < 0) g = 0;
+		if (b < 0) b = 0;
+		int64_t rn = r * gSweetKnobs.alswr;
+		int64_t gn = g * gSweetKnobs.alswg;
+		int64_t bn = b * gSweetKnobs.alswb;
+		int64_t sum = rn + gn + bn;
+		if (sum > 0) {
+			int64_t rf = (rn << 16) / sum;
+			int64_t gf = (gn << 16) / sum;
+			int64_t bf = (bn << 16) / sum;
+			/* sRGB -> CIE 1931 XYZ matrix coefficients in Q16 */
+			xu = (27031LL * rf + 23434LL * gf + 11825LL * bf) >> 16;
+			yu = (13938LL * rf + 46868LL * gf + 4730LL * bf) >> 16;
+			zu = (1267LL * rf + 7811LL * gf + 62279LL * bf) >> 16;
+			if (xu < 100) xu = 100;
+			if (yu < 100) yu = 100;
+			if (zu < 100) zu = 100;
+			int64_t xsum = xu + yu + zu;
+			int64_t cx = (xu << 16) / xsum;
+			int64_t cy = (yu << 16) / xsum;
+			/* McCamy's formula: n = (x - 0.3320) / (0.1858 - y), Q12 */
+			if (cy > 13000) {
+				int64_t n = ((cx - 21758LL) << 12) / (12177LL - cy);
+				if (n < -4096) n = -4096;
+				if (n > 4096) n = 4096;
+				int64_t n2 = (n * n) >> 12;
+				int64_t n3 = (n2 * n) >> 12;
+				cct = ((449LL * n3 + 3525LL * n2 + 6823LL * n) >> 12) + 5520;
+				if (cct < 1500) cct = 1500;
+				if (cct > 15000) cct = 15000;
+			}
+		}
+	} else {
+		int64_t in_cct = sweet_f2q(s->v[1], 1, 1, 0);
+		if (in_cct > 0) {
+			int64_t cx, cy;
+			cct = in_cct;
+			sweet_cct_to_xy(cct, &cx, &cy);
+			xu = cx;
+			yu = cy;
+			zu = 65536LL - cx - cy;
+			if (zu < 100) zu = 100;
+		}
+	}
+
+	int64_t eff_lux = lux_q16;
+	if (eff_lux < 655) {
+		eff_lux = 655;          /* >= 0.01 lux so c0, c1, c2 stay non-zero even in pitch dark */
+	} else if (eff_lux > (200000LL << 16)) {
+		eff_lux = 200000LL << 16;
+	}
+	/* Scale so Y = eff_lux * pi (205887 = round(pi * 65536)). */
+	uint64_t m = ((uint64_t)eff_lux * 205887ULL) / (uint64_t)yu;
+	*c0_q16 = (int64_t)(((uint64_t)xu * m) >> 16);
+	*c1_q16 = (int64_t)(((uint64_t)yu * m) >> 16);
+	*c2_q16 = (int64_t)(((uint64_t)zu * m) >> 16);
+	*cct_out = cct;
+}
