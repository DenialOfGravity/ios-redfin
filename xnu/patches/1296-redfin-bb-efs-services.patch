+/* ---- Phase 3 helpers for sweet_efs.c ---- */
+
+uint32_t
+sbb_link_ups(void)
+{
+	lck_mtx_lock(&ml_lock);
+	uint32_t u = gl.ups;
+	lck_mtx_unlock(&ml_lock);
+	return u;
+}
+
+void
+sbb_srv_register_local(uint32_t svc, uint32_t inst, uint32_t port)
+{
+	lck_mtx_lock(&ml_lock);
+	srv_add(svc, inst, SBB_NODE_APPS, port);
+	bool up = (gl.state == 2);
+	lck_mtx_unlock(&ml_lock);
+	uint32_t w[5] = { SBB_QRTR_NEW_SERVER, svc, inst, SBB_NODE_APPS, port };
+	struct sbb_qrtr_hdr ch = { 1, SBB_QRTR_NEW_SERVER, SBB_NODE_APPS, SBB_PORT_CTRL, 0, sizeof(w), SBB_NODE_BCAST, SBB_PORT_CTRL };
+	chan_broadcast_ctrl(&ch, (const uint8_t *)w, sizeof(w), -1);
+	if (up) {
+		(void)sbb_qrtr_send(SBB_QRTR_NEW_SERVER, SBB_PORT_CTRL, SBB_NODE_MODEM, SBB_PORT_CTRL, w, sizeof(w));
+	}
+}
+
+static int
+sbb_deliver_local(uint32_t type, uint32_t src_port, uint32_t dst_port, const void *data, uint32_t len)
+{
+	struct sbb_qrtr_hdr lh = { 1, type, SBB_NODE_APPS, src_port, 0, len, SBB_NODE_APPS, dst_port };
+	if (aux_port(dst_port)) {
+		chan_deliver(&chan_aux, &lh, (const uint8_t *)data, len);
+		return 0;
+	}
+	int dst = qr_owner_port(dst_port);
+	if (dst >= 0) {
+		chan_deliver(&qr_slots[dst].chan, &lh, (const uint8_t *)data, len);
+		return 0;
+	}
+	if (!port_kernel_reserved(dst_port)) {
+		lck_mtx_lock(&q_lock);
+		bool w_ok = chan_wland.open;
+		lck_mtx_unlock(&q_lock);
+		if (w_ok) {
+			chan_deliver(&chan_wland, &lh, (const uint8_t *)data, len);
+			return 0;
+		}
+	}
+	return ECONNREFUSED;
+}
+
+int
+sbb_efs_reply(uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *data, uint32_t len)
+{
+	if (dst_node == SBB_NODE_APPS) {
+		return sbb_deliver_local(SBB_QRTR_DATA, src_port, dst_port, data, len);
+	}
+	return sbb_qrtr_send(SBB_QRTR_DATA, src_port, dst_node, dst_port, data, len);
+}
+
+void
+sbb_efs_resume_tx(uint32_t dst_port, uint32_t peer_node, uint32_t peer_port)
+{
+	uint32_t rt[5] = { SBB_QRTR_RESUME_TX, SBB_NODE_APPS, dst_port, 0, 0 };
+	if (peer_node == SBB_NODE_APPS) {
+		(void)sbb_deliver_local(SBB_QRTR_RESUME_TX, dst_port, peer_port, rt, sizeof(rt));
+		return;
+	}
+	(void)sbb_qrtr_send(SBB_QRTR_RESUME_TX, dst_port, peer_node, peer_port, rt, sizeof(rt));
+}
