+/*
+ * 1262: a swap's layers as Apple's display driver takes them. The SwapEnd record is IOMFB's swap record (the layout
+ * the Asahi DCP driver documents as struct dcp_swap): swap id 0x50, per layer l < 4 the surface id 0x54 + 4l, the
+ * source rectangle 0x64 + 16l (x, y, w, h, surface pixels), surface flags 0xa4 + 4l, 0xb4 + 4l, the destination
+ * rectangle 0xc4 + 16l (x, y, w, h, display points 1125x2436), the layers this swap sets 0x104. A layer the mask sets
+ * takes its new surface (id 0: off, 1261); a layer the mask does not name keeps what it had. Photos' All Photos: l0 =
+ * the photo grid (Photos' own surfaces), l1 = backboardd's frame with transparent holes over it; CA sends 0x7 when
+ * both change and 0x2 while only l1 does, so every frame has two live layers.
+ * kern.sweet_present_layers 1: every SwapEnd is completed with the layers it keeps (its record then names every live
+ * layer, so the direct scanout leaves a frame of 2+ layers to the present path) and presentGPU composites 2-4 live
+ * layers (sweet_gpu_present_layers: layer 0 copied, the ones above blended source-over, each scaled from its source
+ * to its destination rectangle). 1 is the default (2026-11-19); 0 = one layer only, as before 1262. The layer state is kept either way.
+ */
+extern "C" uint32_t sweet_present_layers;
+uint32_t sweet_present_layers = 1;	/* default 1 since 2026-11-19 (owner-tested); 0 = off */
+static struct {
+	uint32_t id[SWEET_FB_LAYERS];
+	uint8_t  src[SWEET_FB_LAYERS][16], dst[SWEET_FB_LAYERS][16];
+	uint32_t flags[SWEET_FB_LAYERS], unk[SWEET_FB_LAYERS];
+} sweet_lay;
+static uint32_t sweet_lay_st[5];        /* 1262, this 5 s: swaps completed, composites, layers in them, failed, busy */
+
+static void
+put32(uint8_t *p, uint32_t off, uint32_t v)
+{
+	memcpy(p + off, &v, 4);
+}
+
+/* 1262: with the framebuffer's lock, at SwapEnd, before anything reads the record. */
+static void
+sweet_swap_layers_fill(uint8_t *rec)
+{
+	uint32_t raw = get32(rec, 0x104), set = raw & ((1u << SWEET_FB_LAYERS) - 1), add = 0;
+	if (set == 0) {
+		return;         /* changes no layer */
+	}
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		if (set & (1u << l)) {
+			sweet_lay.id[l] = get32(rec, 0x54 + 4 * l);
+			memcpy(sweet_lay.src[l], rec + 0x64 + 16 * l, 16);
+			memcpy(sweet_lay.dst[l], rec + 0xc4 + 16 * l, 16);
+			sweet_lay.flags[l] = get32(rec, 0xa4 + 4 * l);
+			sweet_lay.unk[l] = get32(rec, 0xb4 + 4 * l);
+		} else if (sweet_present_layers && sweet_lay.id[l] != 0) {
+			put32(rec, 0x54 + 4 * l, sweet_lay.id[l]);
+			memcpy(rec + 0x64 + 16 * l, sweet_lay.src[l], 16);
+			memcpy(rec + 0xc4 + 16 * l, sweet_lay.dst[l], 16);
+			put32(rec, 0xa4 + 4 * l, sweet_lay.flags[l]);
+			put32(rec, 0xb4 + 4 * l, sweet_lay.unk[l]);
+			add |= 1u << l;
+		}
+	}
+	if (add != 0) {
+		put32(rec, 0x104, raw | add);
+		sweet_lay_st[0]++;
+	}
+}
