+	uint32_t  dx, dy, dw, dh;       /* destination rectangle, panel pixels */
+	uint32_t  blend;                /* 0 copy, 1 source-over */
+};
+int sweet_gpu_present_layers(const struct sweet_gpu_layer *ly, uint32_t nl, uint32_t fb_pitch, uint32_t corner_radius);
