 /* one host packet; gw_lock held. *want_up: mode 1 asks for a chip bring-up after the lock is dropped */
@@ -1175,6 +1516,9 @@ gw_host_packet(const uint8_t *p, unsigned n, uint8_t *out, unsigned *no, unsigne
