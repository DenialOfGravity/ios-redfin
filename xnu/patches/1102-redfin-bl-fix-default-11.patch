From d1e243f683117de702eb02bb94ed395c89a3e032 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 21:35:31 +0100
Subject: [PATCH] 1102 redfin: kern.sweet_bl_fix default 11 (calibration on at
 boot, ALS keep-alive off)

1101's backlight-calibration-parameters passed the runtime test (rk1f:
9 keys read, no crash, Lmax_panel 500, wake -> backlight 391). The boot
cmdline is full, so bit 8 is on by default. Bit 4 (100 lux ALS keep-alive
until sensd) is dropped from the default: it only made auto-brightness act
on a fake 100 lux before sensd's first sample.
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 756a0e0..b4f4cf6 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -538,7 +538,7 @@ OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
  */
 extern "C" {
 uint32_t sweet_bl_trace = 3;
-uint32_t sweet_bl_fix = 7;      /* 1101: 8 (backlight-calibration-parameters) off at boot until proven; sweetblfix=15 */
+uint32_t sweet_bl_fix = 11;     /* 1102: 1 + 2 + 8 (calibration proven on rk1f); 4 (ALS keep-alive) off: pointless once the panel range is right */
 }
 static IOSimpleLock *sweet_blt_lock;
 static uint64_t sweet_blt_refill;
-- 
2.53.0

