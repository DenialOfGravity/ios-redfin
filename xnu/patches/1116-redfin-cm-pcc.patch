+	char t[160];
+	size_t o = 0;
+	for (uint32_t r = MDP_DSPP_TOP; r < MDP_DSPP_TOP + 0x80 && o + 16 < sizeof(t); r += 4) {
+		uint32_t v = sweet_mdp_rd(r);
