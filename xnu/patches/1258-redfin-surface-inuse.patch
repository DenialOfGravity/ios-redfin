+	uint32_t st_hold = XST(hold), st_holdEnd = XST(holdEnd);
+	uint32_t st_holdTimeout = XST(holdTimeout), st_holdOverflow = XST(holdOverflow);
+	uint32_t st_cancel = XST(cancel), st_maxHeld = XST(maxHeld);
+	uint32_t st_subListed = XST(subListed), st_subNamed = XST(subNamed);
+	uint32_t st_subAll = XST(subAll), st_subHeld = XST(subHeld), st_subOverflow = XST(subOverflow);
+	uint32_t st_importHit = XST(importHit), st_importMiss = XST(importMiss);
+	uint32_t st_lockWait = XST(lockWait), st_lockWaitLate = XST(lockWaitLate);
+	uint64_t st_lockWaitNs = XST(lockWaitNs);
+#undef XST
+	IOLog("SWEET SURF INUSE: 5s: mode %d | publishes %u (in use %u) | gpu holds +%u -%u timeout %u overflow %u cancel %u, "
