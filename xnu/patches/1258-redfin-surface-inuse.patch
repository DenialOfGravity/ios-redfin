+			return kIOReturnBadArgument;
+		}
 		if (nbuf == 0 || nbuf > nmax || nbuf > SWEET_V2_IB_HW || (rq->flags & ~SWEET_V2_SUBMIT_FLAGS) ||
-		    inSize != sizeof(NativeAdrenoAbiSubmit) + extra * sizeof(NativeAdrenoAbiSubmitBuffer)) {
