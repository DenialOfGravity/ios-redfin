+					s->gpuWritePending = (pbit == 2) ? 1 : 0;
+					s->gpuHoldAbs = now;
+					__atomic_store_n(&s->gpuHold, 1, __ATOMIC_RELAXED);
+					uint32_t nn = sweet_inuse_n + 1;
+					sweet_inuse_held[sweet_inuse_n] = s;
+					__atomic_store_n(&sweet_inuse_n, nn, __ATOMIC_RELAXED);
+					added = true;
+					__atomic_fetch_add(&sweet_inuse_st.hold, 1, __ATOMIC_RELAXED);
+					if (nn > sweet_inuse_st.maxHeld) {
+						sweet_inuse_st.maxHeld = nn;
+					}
+					sweet_surface_publish_use(s);
+					if (pend != NULL) {
+						pend[i] = pbit;
+					}
+				} else {
+					__atomic_fetch_add(&sweet_inuse_st.holdOverflow, 1, __ATOMIC_RELAXED);
+				}
+			} else {
+				s->gpuPending++;
+				if (pbit == 2) {
+					s->gpuWritePending++;
+				}
+				s->gpuHoldAbs = now;    /* a new job is being queued: the 2 s cap starts again */
+				if (pend != NULL) {
+					pend[i] = pbit;
+				}
+			}
+		} else if (fence == SWEET_SURF_FENCE_CANCEL) {
+			if (pend == NULL || pend[i] != 0) {
+				uint8_t pbit = pend != NULL ? pend[i] : 1;
+				if (pend != NULL) {
+					pend[i] = 0;
+				}
+				if (s->gpuHold != 0) {
+					if (s->gpuPending > 0 && --s->gpuPending == 0) {
+						wake_pend = true;
+					}
+					if (pbit == 2 && s->gpuWritePending > 0 && --s->gpuWritePending == 0) {
+						wake_pend = true;
+					}
+					if (s->gpuPending == 0 && s->gpuFence == SWEET_SURF_FENCE_PENDING) {
+						added = true;   /* the thread drops it at its next look */
+					}
+					__atomic_fetch_add(&sweet_inuse_st.cancel, 1, __ATOMIC_RELAXED);
+				}
+			}
+		} else {
+			if (pend != NULL && pend[i] != 0) {
+				uint8_t pbit = pend[i];
+				pend[i] = 0;
+				if (s->gpuHold != 0) {
+					if (s->gpuPending > 0 && --s->gpuPending == 0) {
+						wake_pend = true;
+					}
+					if (pbit == 2 && s->gpuWritePending > 0 && --s->gpuWritePending == 0) {
+						wake_pend = true;
+					}
+				}
+			}
+			if (s->gpuHold == 0) {
+				if (sweet_inuse_n < SWEET_INUSE_MAX) {
+					kept = true;
+					s->gpuFence = fence;
+					s->gpuHoldAbs = now;
+					__atomic_store_n(&s->gpuHold, 1, __ATOMIC_RELAXED);
+					uint32_t nn = sweet_inuse_n + 1;
+					sweet_inuse_held[sweet_inuse_n] = s;
+					__atomic_store_n(&sweet_inuse_n, nn, __ATOMIC_RELAXED);
+					added = true;
+					__atomic_fetch_add(&sweet_inuse_st.hold, 1, __ATOMIC_RELAXED);
+					if (nn > sweet_inuse_st.maxHeld) {
+						sweet_inuse_st.maxHeld = nn;
+					}
+					sweet_surface_publish_use(s);
+				} else {
+					__atomic_fetch_add(&sweet_inuse_st.holdOverflow, 1, __ATOMIC_RELAXED);
+				}
+			} else if (s->gpuFence == SWEET_SURF_FENCE_PENDING || (int32_t)(fence - s->gpuFence) > 0) {
+				s->gpuFence = fence;    /* one ring: the newest fence covers the older jobs */
+				s->gpuHoldAbs = now;
+			}
+			if (writes != NULL && writes[i] &&
+			    (s->gpuWriteFence == 0 || (int32_t)(fence - s->gpuWriteFence) > 0)) {
+				s->gpuWriteFence = fence;
+			}
+		}
+		IOLockUnlock(sweet_inuse_lock);
+		if (!kept) {
+			s->release();
+		}
+	}
+	if (wake_pend) {
+		IOLockWakeup(sweet_inuse_lock, &sweet_inuse_pend_chan, false);
+	}
+	if (added) {
+		IOLockWakeup(sweet_inuse_lock, &sweet_inuse_chan, false);
+	}
+}
