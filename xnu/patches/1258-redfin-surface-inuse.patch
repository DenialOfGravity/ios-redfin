+void
+sweet_surface_submit_stat(bool listed, uint32_t named, uint32_t held, bool overflow)
+{
+	if (listed) {
+		__atomic_fetch_add(&sweet_inuse_st.subListed, 1, __ATOMIC_RELAXED);
+		__atomic_fetch_add(&sweet_inuse_st.subNamed, named, __ATOMIC_RELAXED);
+	} else {
+		__atomic_fetch_add(&sweet_inuse_st.subAll, 1, __ATOMIC_RELAXED);
+	}
+	__atomic_fetch_add(&sweet_inuse_st.subHeld, held, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&sweet_inuse_st.subOverflow, overflow ? 1 : 0, __ATOMIC_RELAXED);
+}
+
+/*
+ * 1258 bit 3 (8): IOSurfaceLock waits for the GPU as on iOS: read-only for the newest job that writes the surface,
+ * read-write for the newest job that uses it. At most 200 ms (then the lock goes ahead, counted late).
+ */
+static void
+sweet_inuse_lock_wait(SweetSurface *s, bool readOnly)
+{
+	int mode = sweet_surface_inuse_mode();
+	if (mode == 0 || (mode & 8) == 0) {
+		return;
+	}
+	sweet_inuse_ensure_lock();
+	uint64_t t0 = mach_absolute_time(), budget_ns = 200000000ULL, budget_abs;
+	nanoseconds_to_absolutetime(budget_ns, &budget_abs);
+	uint64_t dl = t0 + budget_abs;
+	IOLockLock(sweet_inuse_lock);
+	while ((readOnly ? s->gpuWritePending : s->gpuPending) > 0) {
+		if (mach_absolute_time() >= dl) {
+			break;
+		}
+		IOLockSleepDeadline(sweet_inuse_lock, &sweet_inuse_pend_chan, dl, THREAD_UNINT);
+	}
+	uint32_t f = s->gpuWriteFence;
+	if (!readOnly && s->gpuHold != 0 && s->gpuFence != SWEET_SURF_FENCE_PENDING &&
+	    (f == 0 || (int32_t)(s->gpuFence - f) > 0)) {
+		f = s->gpuFence;
+	}
+	IOLockUnlock(sweet_inuse_lock);
+	if (f == 0 || sweet_gpu_fence_done(f)) {
+		return;
+	}
+	uint64_t now = mach_absolute_time(), elapsed_ns = 0;
+	absolutetime_to_nanoseconds(now - t0, &elapsed_ns);
+	uint64_t rem_ns = elapsed_ns < budget_ns ? budget_ns - elapsed_ns : 1;
+	bool late = sweet_gpu_wait_fence_ns(f, rem_ns) != 0;
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	__atomic_fetch_add(&sweet_inuse_st.lockWait, 1, __ATOMIC_RELAXED);
+	if (late) {
+		__atomic_fetch_add(&sweet_inuse_st.lockWaitLate, 1, __ATOMIC_RELAXED);
+	}
+	__atomic_fetch_add(&sweet_inuse_st.lockWaitNs, ns, __ATOMIC_RELAXED);
+}
