+		struct pdp_unit *u = &pdp_units[i];
+		if (u->ifp == NULL) {
+			continue;
+		}
+		o += snprintf(s + o, cap - (size_t)o, " pdp_ip%u mux %u %s rx %llu/%llu drop %llu tx %llu/%llu nohook %llu down %llu "
+		    "blk %llu err %llu echo %llu tdrop %llu;", i, pdp_mux[i], u->up ? "up" : "down", u->rx_pkts, u->rx_bytes,
+		    u->rx_drops, u->tx_pkts, u->tx_bytes, u->tx_nohook, u->tx_down, u->tx_blocked, u->tx_err, u->test_echoes,
+		    u->test_drops);
+	}
+	int e = SYSCTL_OUT(req, s, strlen(s) + 1);
+	kfree_data(s, cap);
+	return e;
+}
