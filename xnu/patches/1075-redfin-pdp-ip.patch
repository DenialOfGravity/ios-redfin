+			}
+		}
+		t[k++] = v;
+	}
+	if (k != SWEET_PDP_NUNITS) {
+		return EINVAL;          /* all eight, in unit order */
+	}
+	for (uint32_t i = 0; i < SWEET_PDP_NUNITS; i++) {
+		os_atomic_store(&pdp_mux[i], t[i], relaxed);
+	}
