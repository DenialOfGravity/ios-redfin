+	uint32_t dl_pend = 0, ul_pend = 0, dl_acked = 0, ul_acked = 0, dl_badm = 0, ul_badm = 0, seconds = 0, wm_seen[4];
+	uint32_t ring, queued, under, periods;
+	bool said_no_dl = false, said_no_ul = false;
+
