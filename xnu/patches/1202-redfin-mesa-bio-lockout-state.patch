+sysctl_sweet_mesa_sks(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2,
+    struct sysctl_req *req)
+{
+	int v = gSks, changed = 0;
+	int e = sysctl_io_number(req, gSks, sizeof(gSks), &v, &changed);
+	if (e || !changed) {
+		return e;
