+/* ---- 1158: pre-registration BindMuxDataPort retry (kern.sweet_wds_bindfix) ----
+ * On a cold boot the SIM PIN is entered late. CommCenter binds its WDS data port
+ * (WDS 0x00a2) once, at launch, while the SIM is still PIN-locked/unregistered; the
+ * modem rejects the bind (error 0x3) and CommCenter never re-binds, so the cid stays
+ * on mux 0 and every later StartNetworkInterface targets a dead mux. With bindfix on
+ * we tell CommCenter the bind succeeded (so it records cid->mux and never falls back
+ * to mux 0), set our own cid->mux to match, and the router re-issues the bind to the
+ * modem on CommCenter's own WDS client port until the (now registered) modem accepts
+ * it; the matching StartNetworkInterface is held (d_cid_ready) until then. With it 0
+ * the modem's error is forwarded to CommCenter unchanged (k26). */
+static struct dbind *
+d_bind_find(uint32_t pipe, uint32_t sess, unsigned cid)
+{
+	for (int i = 0; i < D_NBIND; i++) {
+		struct dbind *b = &D->bind[i];
+		if (b->used && b->pipe == pipe && b->sess == sess && b->cid == cid) {
+			return b;
+		}
+	}
+	return NULL;
+}
+
+/* true unless this cid still has a BindMuxDataPort pending on the modem (1158) */
+static bool
+d_cid_ready(uint32_t pipe, uint32_t sess, unsigned cid)
+{
+	return !sweet_wds_bindfix || D == NULL || d_bind_find(pipe, sess, cid) == NULL;
+}
+
+/* record (or refresh) a cid's bind as pending-retry; returns the slot or NULL if full */
+static struct dbind *
+d_bind_pend(struct cl *c, unsigned mux)
+{
+	struct dbind *b = d_bind_find(c->pipe, c->sess, c->cid);
+	if (!b) {
+		for (int i = 0; i < D_NBIND && !b; i++) {
+			if (!D->bind[i].used) {
+				b = &D->bind[i];
+			}
+		}
+	}
+	if (!b) {
+		return NULL;
+	}
+	b->used = 1;
+	b->svc = c->svc;
+	b->cid = c->cid;
+	b->mux = (uint8_t)mux;
+	b->ci = (int)(c - cl);
+	b->pipe = c->pipe;
+	b->sess = c->sess;
+	b->port = c->port;
+	b->next = sbb_ms();
+	return b;
+}
+
+/* flip a QMI response's result TLV 0x02 to success {0,0} in place (1158) */
+static int
+d_force_ok(uint8_t *tl, uint32_t tn)
+{
+	uint32_t l = 0;
+	uint8_t *r = (uint8_t *)tlv_find(tl, tn, 0x02, &l);
+	if (!r || l < 4) {
+		return 0;
+	}
+	r[0] = r[1] = r[2] = r[3] = 0;
+	return 1;
+}
+
+
 /* ---- CommCenter's answers / indications on data clients (in place, same lengths) ---- */
 
 static void
@@ -3851,11 +3945,33 @@ d_answer(struct cl *c, uint8_t *sdu, uint32_t len, const uint8_t *rq, uint32_t r
 	}
 	if (type == 0x02 && msg == 0x00a2) {
 		int mx = tlv_byte(rq, rqn, 0x11);
-		LOG("data: WDS BindMuxDataPort %s/%u cid %u mux %d: %s 0x%x\n", pipe_name[c->pipe], c->sess, c->cid, mx, res == 0 ?
-		    "ok" : "error", res == 0 ? 0 : er);
-		if (res == 0 && mx > 0) {
+		if (res == 0) {
+			struct dbind *pb = sweet_wds_bindfix ? d_bind_find(c->pipe, c->sess, c->cid) : NULL;
+			if (pb) {
+				pb->used = 0;   /* 1158: CommCenter's own bind finally succeeded: drop the pending retry */
+			}
+			LOG("data: WDS BindMuxDataPort %s/%u cid %u mux %d: ok 0x0\n", pipe_name[c->pipe], c->sess, c->cid, mx);
+			if (mx > 0) {
+				x->mux = (uint8_t)mx;
+				d_mux_map((unsigned)mx);
+			}
+		} else if (sweet_wds_bindfix && mx > 0 && d_force_ok(tl, tn)) {
+			/*
+			 * 1158: the modem rejected the bind (SIM not yet registered). Tell
+			 * CommCenter it succeeded so it records cid->mux, set our own cid->mux
+			 * to match, and keep re-sending the bind to the modem (data_poll) until
+			 * it is accepted; the matching StartNetworkInterface is held until then.
+			 */
 			x->mux = (uint8_t)mx;
 			d_mux_map((unsigned)mx);
+			struct dbind *pb = d_bind_pend(c, (unsigned)mx);
+			dst.bind_fix++;
+			LOG("data: WDS BindMuxDataPort %s/%u cid %u mux %d: modem error 0x%x pre-registration -> success to "
+			    "CommCenter, bind %s for modem retry (kern.sweet_wds_bindfix)\n", pipe_name[c->pipe], c->sess, c->cid,
+			    mx, er, pb ? "queued" : "NOT queued (no slot)");
+		} else {
+			LOG("data: WDS BindMuxDataPort %s/%u cid %u mux %d: error 0x%x\n", pipe_name[c->pipe], c->sess, c->cid,
+			    mx, er);
 		}
 	} else if (type == 0x02 && msg == 0x0020) {
 		if (res == 0 && tlv_u32(tl, tn, 0x01, &v) == 0) {
@@ -4189,7 +4305,7 @@ d_request(unsigned pipe, unsigned svc, unsigned cid, const uint8_t *s, uint32_t
 		pb_start("CommCenter's first WDS request");
 	}
 	if (svc == 0x01 && msg == 0x0020) {
-		if (!d_start_ok()) {           /* 1088: IPA ready and the router's WDA SetDataFormat answered */
