 			if (d_hold(DH_START, pipe, svc, cid, msg, s, len)) {
 				LOG("data: StartNetworkInterface %s/%u cid %u: IPA not ready and the hold queue is full: error 0x%x\n",
 				    pipe_name[pipe], cur_sess, cid, QMI_ERR_CALL_FAILED);
@@ -4198,8 +4314,9 @@ d_request(unsigned pipe, unsigned svc, unsigned cid, const uint8_t *s, uint32_t
 			}
 			dst.held_start++;
 			LOG("data: StartNetworkInterface %s/%u cid %u held: %s (%u s max)\n", pipe_name[pipe], cur_sess, cid,
-			    !sweet_ipa_ready() ? "IPA data plane not ready (kern.sweet_ipa_state != 3)" : "the router's WDA SetDataFormat "
-			    "not answered yet (1088)", D_HELD_START_MS / 1000);
+			    !sweet_ipa_ready() ? "IPA data plane not ready (kern.sweet_ipa_state != 3)" :
+			    !d_cid_ready(pipe, cur_sess, cid) ? "its BindMuxDataPort not yet confirmed on the modem "
+			    "(kern.sweet_wds_bindfix)" : "the router's WDA SetDataFormat not answered yet (1088)", D_HELD_START_MS / 1000);
 			return;
 		}
 		d_start(pipe, cid, s, len);
@@ -4310,12 +4427,44 @@ data_poll(uint64_t now)
 		printf("SWEET QMUX: profile backup auto-acknowledged (autoack)\n");
 	}
 	wda_own_poll(now);              /* 1088 */
+	if (sweet_wds_bindfix && act) {         /* 1158: re-send rejected pre-registration binds to the modem */
+		for (int i = 0; i < D_NBIND; i++) {
+			struct dbind *b = &D->bind[i];
+			if (!b->used || now < b->next) {
+				continue;
+			}
+			struct cl *bc = cl_get(b->pipe, b->sess, 0x01, b->cid, 0);
+			if (!bc || !bc->dat) {
+				LOG("data: pending BindMuxDataPort cid %u dropped: WDS client gone\n", b->cid);
+				b->used = 0;
+				continue;
+			}
+			b->ci = (int)(bc - cl);
+			b->port = bc->port;
+			uint8_t t[32], muxb = b->mux;
+			uint32_t o = 0, ep[2] = { 4, 1 };
+			put_tlv(t, &o, 0x10, ep, 8);
+			put_tlv(t, &o, 0x11, &muxb, 1);
+			if (data_opts & DOPT_BIND_TETH) {
+				uint32_t one = 1;
+				put_tlv(t, &o, 0x13, &one, 4);
+			}
+			cur_pipe = b->pipe;
+			cur_sess = b->sess;
+			b->next = now + D_BIND_RETRY_MS;
+			if (d_own_send(DO_BIND, b->ci, b->port, 0x01, 0x00a2, t, o, 0, (uint8_t)i) == 0) {
+				dst.bind_rt++;
+				LOG("data: BindMuxDataPort cid %u mux %u -> modem (port %#x, kern.sweet_wds_bindfix retry)\n",
+				    b->cid, b->mux, b->port);
+			}
+		}
+	}
 	for (int i = 0; i < D_NHOLD; i++) {
 		struct dhold *h = &D->hold[i];
 		if (!h->used) {
 			continue;
 		}
-		if (h->kind == DH_START && act && d_start_ok()) {
+		if (h->kind == DH_START && act && d_start_ok() && d_cid_ready(h->pipe, h->sess, h->cid)) {
 			cur_pipe = h->pipe;
 			cur_sess = h->sess;
 			h->used = 0;
@@ -4403,12 +4552,12 @@ data_stats(char *buf, size_t len)
 	o = snprintf(buf, len, "data %s (sweetbb 0x%x rules %d fwd %d opts %d) | fwd WDS %u WDA %u QOS %u DSD %u DFS %u | starts ok %u "
 	    "err %u held %u released %u timeout %u rate-limited %u | translations WDA %u (answers %u) bind %u | gw cc %u own %u | "
 	    "stops sent %u closes %u | ups %u downs %u muxmap %u | 5564 local %u | profiles: backup %s (%d) writes %u held %u "
-	    "released %u timeout %u | handles per mux:", data_active() ? "ON" : "off", sweet_bb, qmi_rules, data_fwd, data_opts,
+	    "released %u timeout %u | bind fix %u retry %u ok %u | handles per mux:", data_active() ? "ON" : "off", sweet_bb, qmi_rules, data_fwd, data_opts,
 	    svc_cnt[0x01].fwd, svc_cnt[0x1a].fwd, svc_cnt[0x04].fwd, svc_cnt[0x2a].fwd, svc_cnt[0x30].fwd, dst.starts_ok,
 	    dst.starts_err, dst.held_start, dst.rel_start, dst.to_start, dst.rate, dst.wda_tr, dst.wda_ans, dst.bind_tr, dst.gw_cc,
 	    dst.gw_own, dst.stops_sent, dst.closes, dst.ups, dst.downs, dst.muxmap, dst.local5564, pb_state == 0 ? "none" :
 	    pb_state == 1 ? "listing" : pb_state == 2 ? "reading" : pb_state == 3 ? "ready" : "acked", pb_n, dst.prof_writes,
-	    dst.held_prof, dst.rel_prof, dst.to_prof);
+	    dst.held_prof, dst.rel_prof, dst.to_prof, dst.bind_fix, dst.bind_rt, dst.bind_rt_ok);
 	for (unsigned m = 1; m < 256 && o < (int)len - 40; m++) {
 		int h = d_mux_handles(m);
 		if (h || D->mx[m].up) {
@@ -6064,6 +6213,30 @@ sysctl_wds_autoack SYSCTL_HANDLER_ARGS
 SYSCTL_PROC(_kern, OID_AUTO, sweet_wds_autoack, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_wds_autoack, "I",
     "redfin 1157: 1 (default) = kernel auto-acknowledges the WDS profile backup (pb_state 3->4) with no userland step; 0 = wait for kern.sweet_wds_profiles_ack");
 
+static int
+sysctl_wds_bindfix SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = sweet_wds_bindfix, changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e || !changed) {
+		return e;
+	}
+	if (proc_suser(req->p) != 0) {
+		return EPERM;
+	}
+	if (v != 0 && v != 1) {
+		return EINVAL;
+	}
+	sweet_wds_bindfix = v;
+	printf("SWEET QMUX: kern.sweet_wds_bindfix = %d\n", v);
+	sbb_wake();
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_wds_bindfix, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_wds_bindfix, "I",
+    "redfin 1158: 1 (default) = a BindMuxDataPort the modem rejects before registration is answered success to CommCenter and retried on the modem until accepted (StartNetworkInterface held until then); 0 = k26 (modem error forwarded as-is)");
+
