From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 10:00:00 +0100
Subject: [PATCH] 1149 redfin: NFC persona: HDLL download replies carry the frame STATUS byte

Why 1147 (high version) and 1148 (exact bundled version) failed identically: an NXP HDLL
RESPONSE payload starts with a status byte (PH_DL_STATUS_OK = 0x00). phDnldNfc_ProcessFrame ->
phDnldNfc_UpdateRsp checks pBuff[2] == 0x00 and copies only the bytes after it to the command
callback (wLen = LEN - 1). Our replies had no status byte, so 0x42 sat in the status slot and the
frame layer failed every reply ("Unsuccessful Status received") before the version was ever
compared -> GetFwVersionTrans Failed / 0x00FF / nfrestore recovery loop.

GET_VERSION reply is now 00 09 | 00 | 42 02 01 5a 01 00 00 00 | 88 1c (8 data bytes, as
phDnldNfc_DnldGetVersionCb expects). kern.sweet_nfc_fwif_fmt 0x100000 = old 1148 form.
New bit 0x80000 also answers F0 RESET (status), F2 GET_SESSION_STATE (closed, LC 0x11 oper),
E0 CHECK_INTEGRITY (all CRC bits ok) and C0 WRITE (status; virtual, nothing written).
HDLL LEN is now 10 bits (b0 bit 2 = chunk flag).

SAFETY unchanged: host-bound replies only, gateway mode 0, nothing reaches the chip, no SPI/GPIO.
Default-off (needs 0x40000 with the 0x4000 group). Test: kern.sweet_nfc_fwif_fmt = 0xC5D00.

---
diff --git a/bsd/dev/sweet_nfc.c b/bsd/dev/sweet_nfc.c
index fddad9b..7aa12ef 100644
--- a/bsd/dev/sweet_nfc.c
+++ b/bsd/dev/sweet_nfc.c
@@ -2680,32 +2680,84 @@ gw_packet_done(unsigned need, uint8_t *out, unsigned *no, unsigned cap, bool *wa
 	gw.pend = true;
 }
 
-/* 1147/1148: reply to the NXP HDLL GET_VERSION read in download mode with the EXACT bundled firmware version so
- * nfcd's major-version gate passes (ff ff is REJECTED: bNewVer[1] >= bCurrVer[1] fails -> 0x3A/0x00FF, recovery loop)
- * and it treats the chip firmware as in-sync (no download/write). HDLL framing [LEN_hi LEN_lo | payload | CRC16],
- * CRC-16/CCITT-FALSE over LEN+payload (the same nci_crc16 the NCI persona uses). GET_VERSION response payload is 8
- * bytes: P[0]=0x42 (our hw id), P[3],P[4]=bCurrVer. bCurrVer must EQUAL bNewVer read from the bundled image
- * /usr/standalone/firmware/nfrestore/firmware/fw/PN549_FW_02_01_5A_rev88207.bin: header off 0x04 = 5a 01
- * ([FwMinor,FwMajor]), so bCurrVer[0]=0x5a, bCurrVer[1]=0x01. Sent to the host over the same control unit
- * nfcd writes on; nothing reaches the chip. */
+/* 1147/1148/1149: answer NXP HDLL download-mode commands from the persona (host-bound only; nothing reaches the chip).
+ * HDLL framing [LEN_hi LEN_lo | payload | CRC16], LEN = ((b0 & 3) << 8) | b1 (b0 bit 2 = chunk flag), CRC-16/CCITT-FALSE
+ * over LEN+payload (the same nci_crc16 the NCI persona uses).
+ * 1149: a RESPONSE payload starts with a STATUS byte (PH_DL_STATUS_OK = 0x00); the frame layer
+ * (phDnldNfc_ProcessFrame -> phDnldNfc_UpdateRsp) checks pBuff[2] == 0x00 ("Unsuccessful Status received!!" otherwise)
+ * and hands only the bytes AFTER it to the command callback, wLen = LEN - 1. 1147/1148 had no status byte: our first
+ * data byte 0x42 sat in the status slot, so every reply failed in the frame layer (GetFwVersionTrans: Failed, 0x00FF)
+ * whatever version it carried; that is why the exact-version 1148 looped exactly like the high-version 1147.
+ * GET_VERSION data (8 bytes, phDnldNfc_DnldGetVersionCb): 42 (hw/platform) 02 (ROM, must be 1..3) 01 5a 01 (bCurrVer =
+ * bNewVer of PN549_FW_02_01_5A: [FwMinor,FwMajor]) 00 00 00. Wire: 00 09 00 42 02 01 5a 01 00 00 00 88 1c.
+ * kern.sweet_nfc_fwif_fmt 0x100000 = old 1148 form without the status byte (for comparison only). */
 static void
-gw_dl_reply_getversion(u_int32_t unit)
+gw_dl_send(u_int32_t unit, const uint8_t *pl, unsigned n, const char *note)
 {
-	uint8_t r[12] = { 0x00, 0x08, 0x42, 0x02, 0x01, 0x5a, 0x01, 0x00, 0x00, 0x00, 0xb1, 0xdb };
-	uint16_t c = nci_crc16(r, 10);  /* over LEN+payload; must equal the b1 db trailer */
+	uint8_t r[2 + 40 + 2];
+	uint16_t c;
 
-	r[10] = (uint8_t)(c >> 8);
-	r[11] = (uint8_t)c;
-	if (c != 0xb1db) {
-		SAY("nfc-hci: persona: 1148: GET_VERSION CRC %04x != b1db (not sent)\n", c);
+	if (n > 40) {
 		return;
 	}
-	if (gw_ctl != NULL && ctl_enqueuedata(gw_ctl, unit, r, sizeof(r), 0) == 0) {
+	r[0] = (uint8_t)(n >> 8);
+	r[1] = (uint8_t)n;
+	memcpy(r + 2, pl, n);
+	c = nci_crc16(r, 2 + n);
+	r[2 + n] = (uint8_t)(c >> 8);
+	r[3 + n] = (uint8_t)c;
+	if (gw_ctl != NULL && ctl_enqueuedata(gw_ctl, unit, r, 4 + n, 0) == 0) {
 		gw_up_pkts++;
-		gw_hexlog("nfc-hci", r, sizeof(r), "dnld <persona GET_VERSION exact-version reply 5a 01, CRC16 b1 db");
+		gw_hexlog("nfc-hci", r, 4 + n, note);
 	} else {
 		gw_up_fail++;
-		SAY("nfc-hci: persona: 1148: GET_VERSION reply send FAILED\n");
+		SAY("nfc-hci: persona: 1149: dnld reply send FAILED (%s)\n", note);
+	}
+}
+
+static void
+gw_dl_reply_getversion(u_int32_t unit)
+{
+	static const uint8_t v_st[9] = { 0x00, 0x42, 0x02, 0x01, 0x5a, 0x01, 0x00, 0x00, 0x00 };
+
+	if (nfc_fwif_fmt & 0x100000) {
+		gw_dl_send(unit, v_st + 1, 8, "dnld <persona GET_VERSION 1148 form (no status byte)");
+	} else {
+		gw_dl_send(unit, v_st, 9, "dnld <persona GET_VERSION status 00 + 42 02 01 5a 01 00 00 00");
+	}
+}
+
+/* 1149: the other HDLL commands nfcd/nfrestore may send around the version read, answered only with
+ * kern.sweet_nfc_fwif_fmt 0x80000 (else logged only, as 1146). Opcodes from NXP phDnldNfc: F0 RESET, F2
+ * GET_SESSION_STATE, E0 CHECK_INTEGRITY, C0 WRITE. Returns true if answered. */
+static bool
+gw_dl_reply_other(u_int32_t unit, uint8_t op)
+{
+	static const uint8_t st_ok[1] = { 0x00 };
+	/* status, session 00 = closed (no interrupted download), (unused), life cycle 0x11 = phDnldNfc_LCOper */
+	static const uint8_t sess[4] = { 0x00, 0x00, 0x00, 0x11 };
+	/* status + 31 bytes; data[0] bits 0-6 set = user/trim/protected data, patch/function code, patch/function
+	 * table CRCs all OK (phLibNfc_VerifyCrcStatus) */
+	static const uint8_t integ[32] = { 0x00, 0x7f };
+
+	if (!(nfc_fwif_fmt & 0x80000)) {
+		return false;
+	}
+	switch (op) {
+	case 0xf0:
+		gw_dl_send(unit, st_ok, 1, "dnld <persona RESET status 00");
+		return true;
+	case 0xf2:
+		gw_dl_send(unit, sess, 4, "dnld <persona GET_SESSION_STATE closed, LC oper");
+		return true;
+	case 0xe0:
+		gw_dl_send(unit, integ, 32, "dnld <persona CHECK_INTEGRITY all CRC ok");
+		return true;
+	case 0xc0:
+		gw_dl_send(unit, st_ok, 1, "dnld <persona WRITE status 00 (virtual; nothing written)");
+		return true;
+	default:
+		return false;
 	}
 }
 
@@ -2727,7 +2779,7 @@ gw_dl_capture(u_int32_t unit, mbuf_t m)
 			}
 			gw_dl_buf[gw_dl_n++] = d[i++];
 			if (gw_dl_n >= 2) {
-				unsigned plen = ((unsigned)gw_dl_buf[0] << 8) | gw_dl_buf[1];
+				unsigned plen = ((unsigned)(gw_dl_buf[0] & 0x03) << 8) | gw_dl_buf[1];  /* 1149: b0 bit 2 = chunk flag */
 				unsigned need = 2u + plen + 2u;
 
 				if (need > sizeof(gw_dl_buf)) {
@@ -2742,8 +2794,10 @@ gw_dl_capture(u_int32_t unit, mbuf_t m)
 					 * is logged only (not forwarded, not answered) so the next capture reveals nfcd's exit command.
 					 * Nothing reaches the chip. */
 					if (plen >= 3 && gw_dl_buf[2] == 0xf1 && gw_dl_buf[3] == 0x00 && gw_dl_buf[4] == 0x00) {
-						gw_hexlog("nfc-hci", gw_dl_buf, gw_dl_n, "dnld host> HDLL GET_VERSION (answering high version)");
+						gw_hexlog("nfc-hci", gw_dl_buf, gw_dl_n, "dnld host> HDLL GET_VERSION");
 						gw_dl_reply_getversion(unit);
+					} else if (plen >= 1 && gw_dl_reply_other(unit, gw_dl_buf[2])) {
+						gw_hexlog("nfc-hci", gw_dl_buf, gw_dl_n > 24 ? 24 : gw_dl_n, "dnld host> HDLL frame (answered, 1149)");
 					} else {
 						gw_hexlog("nfc-hci", gw_dl_buf, gw_dl_n, "dnld host> HDLL frame (logged only, not forwarded, not answered)");
 					}
@@ -3204,7 +3258,7 @@ SYSCTL_UINT(_kern, OID_AUTO, sweet_nfc_fwif_fmt, CTLFLAG_RW | CTLFLAG_LOCKED, &n
     "6F 20 C0 after NFCEE_DISCOVER and MODE_SET C0, 0x2000 = GET_CONFIG A0EB returns the host-set value; 1139: 0x4000 = "
     "MODE_SET C0/01 00 -> 6F 18 00 (1144; 1145: also for NFCEE 01; 0x8000: 6F 18 02 C0 00), no 6F 20, + A0EB mirror; 1140: 0x10000 = that NTF "
     "deferred by kern.sweet_nfc_ntf_delay_ms as its own packet, 0x20000 = no NTF after the disable RSP; 1146: 0x40000 "
-    "(with 0x4000) = accept DownloadRequest and log the NXP HDLL frames nfcd writes (nfc-hci), forwarding/answering nothing");
+    "(with 0x4000) = accept DownloadRequest, answer HDLL GET_VERSION (1149: with status byte; 0x100000 = old form), 0x80000 = also answer RESET/SESSION_STATE/INTEGRITY/WRITE; nothing forwarded");
 
 static int
 cfg_hexval(char c)
