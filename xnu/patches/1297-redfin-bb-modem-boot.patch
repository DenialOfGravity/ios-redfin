+
+int sweet_rpmh_arc_top(const char *res, uint32_t *top_out);
+int
+sweet_rpmh_arc_top(const char *res, uint32_t *top_out)
+{
+	if (!res || !top_out) {
+		return EINVAL;
+	}
+	int error = rh_ro_ready();
+	if (error) {
+		return error;
+	}
+	uint32_t key[2] = { 0, 0 };
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave != RH_ARC || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			continue;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint16_t len = rh_db16(e + 20);
+			uint16_t off = rh_db16(e + 22);
+			if (len < 2 || !rh_range(aux + off, len)) {
+				return EINVAL;
+			}
+			uint32_t top = 0;
+			for (unsigned k = 0; k < (unsigned)len / 2u; ++k) {
+				if (rh_db16(aux + off + 2u * k) != 0) {
+					top = k;
+				}
+			}
+			*top_out = top;
+			return 0;
+		}
+	}
+	return ENODEV;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
