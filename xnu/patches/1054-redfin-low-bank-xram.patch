From 70105b9cb602680485282783f923579bcfcbf53a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 20:48:07 +0000
Subject: [PATCH] 1054 redfin: low-bank RAM to the VM behind boot-arg xram
 (port of HakiOS 1512 extra RAM)

XNU's window is 0x100000000 + 6 GiB - 20 MiB (1033); the low bank
<0x80000000 0x3bb00000> (955 MB) was unused. About half of it is firmware
carve-outs; the rest is plain RAM (live DT + /proc/iomem, 2026-10-23 recon).

xram=1: System RAM ranges, 459.7 MB. xram=2: plus pil_npu, pil_video,
pil_cdsp, 499.7 MB. With sweetvenus != 0 (1057) 0xa2600000-0xaca00000 and
pil_video stay out (295.7 / 330.7 MB). Default 0 = as before: ptov_table,
the physmap padding and sizing are unchanged; the extra aperture entries
live in their own table, and every new path loops over zero ranges.
xram=3 / xram=4 = 1 / 2 with the Venus ranges out (no room for sweetvenus=
on the rk5a cmdline). Only when the window is at 0x100000000.

Mechanism from Scion-Project/hackios-xnu-kernel PR 179 (patch 1512,
credited): pmap indices after the window's, aperture entries, vm_page_create()
in arm_vm_prot_finalize(); plus ARM_LARGE_MEMORY physmap sizing.

Klog: "SWEET XRAM: 0x..-0x.. (N MB) given to the VM" per range and
"SWEET XRAM: xram=T venus|no venus: P pages (M MB) in R ranges ...".
---
 osfmk/arm/caches.c         |  20 ++++
 osfmk/arm/pmap/pmap.c      |  13 ++-
 osfmk/arm/pmap/pmap.h      |  18 +++
 osfmk/arm/pmap/pmap_data.c |   9 +-
 osfmk/arm/pmap/pmap_data.h |  35 +++++-
 osfmk/arm64/arm_vm_init.c  | 233 ++++++++++++++++++++++++++++++++++++-
 6 files changed, 315 insertions(+), 13 deletions(-)

diff --git a/osfmk/arm/caches.c b/osfmk/arm/caches.c
index b5b3ba9..fd335b6 100644
--- a/osfmk/arm/caches.c
+++ b/osfmk/arm/caches.c
@@ -47,6 +47,26 @@
 
 #include <arm/misc_protos.h>
 
+/*
+ * HakiOS (patch 1512): the boot loader's extra RAM beside the window (arm/pmap/pmap.h) is in the physical aperture too,
+ * and is RAM: not a page to map through a copy window, nor (cache_sync_page) a reason to clean the whole data cache.
+ */
+static inline bool
+hakios_isphysmem(pmap_paddr_t pa)
+{
+	if (((vm_address_t)pa - gPhysBase) < gPhysSize) {
+		return true;
+	}
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pa >= hakios_extra_ram[i].pa) && (pa < hakios_extra_ram[i].end)) {
+			return true;
+		}
+	}
+	return false;
+}
+#undef isphysmem
+#define isphysmem(a) hakios_isphysmem((pmap_paddr_t)(a))
+
 /*
  * dcache_incoherent_io_flush64() dcache_incoherent_io_store64() result info
  */
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index bd099f8..0f1d843 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -1467,7 +1467,7 @@ pmap_set_xprr_perm(
 {
 	pvh_assert_locked(pai);
 
-	const vm_offset_t kva = phystokv(vm_first_phys + (pmap_paddr_t)ptoa(pai));
+	const vm_offset_t kva = phystokv(pai_to_pa(pai));
 	pt_entry_t * const ptep = pmap_pte(kernel_pmap, kva);
 
 	pmap_set_pte_xprr_perm(ptep, expected_perm, new_perm);
@@ -2685,7 +2685,8 @@ pmap_init(
 	 *	structures for pages we allocate to be page tables in
 	 *	pmap_expand().
 	 */
-	_vm_object_allocate(mem_size, pmap_object);
+	/* (HakiOS, patch 1512: page-table pages are kept at ptoa(pa_index(pa)), the extra RAM's after the window's) */
+	_vm_object_allocate(mem_size + ptoa((vm_object_size_t)hakios_extra_ram_pages), pmap_object);
 	pmap_object->copy_strategy = MEMORY_OBJECT_COPY_NONE;
 
 	/*
@@ -3927,7 +3928,7 @@ pmap_set_ptov_ap(unsigned int pai __unused, unsigned int ap __unused, boolean_t
 {
 #if __ARM_PTE_PHYSMAP__
 	pvh_assert_locked(pai);
-	vm_offset_t kva = phystokv(vm_first_phys + (pmap_paddr_t)ptoa(pai));
+	vm_offset_t kva = phystokv(pai_to_pa(pai));
 	pt_entry_t *pte_p = pmap_pte(kernel_pmap, kva);
 
 	pt_entry_t tmplate = *pte_p;
@@ -7441,6 +7442,12 @@ pmap_disconnect(
 boolean_t
 pmap_has_managed_page(ppnum_t first, ppnum_t last)
 {
+	/* HakiOS (patch 1512): the boot loader's extra RAM, below or above the window, is managed too */
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((ptoa(first) < hakios_extra_ram[i].end) && (ptoa(last) >= hakios_extra_ram[i].pa)) {
+			return TRUE;
+		}
+	}
 	if (ptoa(first) >= vm_last_phys) {
 		return FALSE;
 	}
diff --git a/osfmk/arm/pmap/pmap.h b/osfmk/arm/pmap/pmap.h
index 75f3db0..389c60a 100644
--- a/osfmk/arm/pmap/pmap.h
+++ b/osfmk/arm/pmap/pmap.h
@@ -527,6 +527,24 @@ extern pmap_paddr_t kvtophys_nofail(vm_offset_t va);
 extern vm_map_address_t phystokv(pmap_paddr_t pa);
 extern vm_map_address_t phystokv_range(pmap_paddr_t pa, vm_size_t *max_len);
 
+/*
+ * HakiOS (patch 1512): RAM the boot loader gives the kernel beside its window [gPhysBase, gPhysBase + memSize), in the
+ * device tree's /chosen "hakios-extra-ram" (pairs of 64-bit base and size). A phone whose RAM is in two banks (the
+ * Galaxy S9: 2 GB from 0x80000000 with the firmware's and the drivers' ranges in it, 2 GB from 0x880000000) has only
+ * one of them as the window; the free pieces of the other come here. arm_vm_init() reads them, maps them in the
+ * physical aperture (phystokv), and gives each page an index after the window's in the pmap's tables (pa_index); the
+ * pages go to the VM in arm_vm_prot_finalize(), as vm_page_create() pages (ml_static_mfree's way).
+ */
+#define HAKIOS_EXTRA_RAM_MAX 12
+typedef struct {
+	pmap_paddr_t pa;        /* the first byte, PAGE_SIZE aligned */
+	pmap_paddr_t end;       /* past the last byte, PAGE_SIZE aligned */
+	unsigned int pai;       /* the pmap's index (pa_index) of its first page */
+} hakios_extra_ram_t;
+extern hakios_extra_ram_t hakios_extra_ram[HAKIOS_EXTRA_RAM_MAX];
+extern unsigned int hakios_extra_ram_count;     /* ranges in use */
+extern unsigned int hakios_extra_ram_pages;     /* PAGE_SIZE pages in them all */
+
 extern vm_map_address_t pmap_map(vm_map_address_t va, vm_offset_t sa, vm_offset_t ea, vm_prot_t prot, unsigned int flags);
 extern vm_map_address_t pmap_map_high_window_bd( vm_offset_t pa, vm_size_t len, vm_prot_t prot);
 extern kern_return_t pmap_map_block(pmap_t pmap, addr64_t va, ppnum_t pa, uint32_t size, vm_prot_t prot, int attr, unsigned int flags);
diff --git a/osfmk/arm/pmap/pmap_data.c b/osfmk/arm/pmap/pmap_data.c
index d8592c4..801c0ea 100644
--- a/osfmk/arm/pmap/pmap_data.c
+++ b/osfmk/arm/pmap/pmap_data.c
@@ -616,7 +616,7 @@ pmap_data_bootstrap(void)
 	 * needed to cover all of kernel-managed physical memory.
 	 */
 	const uint32_t num_leaf_page_tables =
-	    (uint32_t)(mem_size / ((PAGE_SIZE / sizeof(pt_entry_t)) * ARM_PGBYTES));
+	    (uint32_t)((mem_size + ptoa(hakios_extra_ram_pages)) / ((PAGE_SIZE / sizeof(pt_entry_t)) * ARM_PGBYTES));
 
 	/**
 	 * There should be one PTD per page table (times 2 since we want twice the
@@ -631,7 +631,7 @@ pmap_data_bootstrap(void)
 	vm_size_t ptd_root_table_size = num_ptd_pages * PAGE_SIZE;
 
 	/* Number of VM pages that span all of kernel-managed memory. */
-	const unsigned int npages = (unsigned int)atop(mem_size);
+	const unsigned int npages = (unsigned int)atop(mem_size) + hakios_extra_ram_pages;   /* (HakiOS, patch 1512: and the extra RAM's) */
 
 	/* The pv_head_table and pp_attr_table both have one entry per VM page. */
 	const vm_size_t pp_attr_table_size = npages * sizeof(pp_attr_t);
@@ -1221,8 +1221,9 @@ pmap_enqueue_pages(vm_page_t mem)
 	vm_page_t m_prev;
 	vm_object_lock(pmap_object);
 	while (mem != VM_PAGE_NULL) {
+		/* (HakiOS, patch 1512: pa - gPhysBase, and for the extra RAM beside the window an offset after it) */
 		const vm_object_offset_t offset =
-		    (vm_object_offset_t) ((ptoa(VM_PAGE_GET_PHYS_PAGE(mem))) - gPhysBase);
+		    (vm_object_offset_t) ptoa(pa_index(ptoa(VM_PAGE_GET_PHYS_PAGE(mem))));
 
 		vm_page_insert_wired(mem, pmap_object, offset, VM_KERN_MEMORY_PTE);
 		m_prev = mem;
@@ -1545,7 +1546,7 @@ pmap_pages_free(pmap_paddr_t pa, __assert_only unsigned size)
 		 * Remove the page from the pmap's VM object and return it back to the
 		 * VM's global free list of pages.
 		 */
-		mem = vm_page_lookup(pmap_object, (pa - gPhysBase));
+		mem = vm_page_lookup(pmap_object, ptoa(pa_index(pa)));
 		assert(mem != VM_PAGE_NULL);
 		assert(VM_PAGE_WIRED(mem));
 		vm_page_lock_queues();
diff --git a/osfmk/arm/pmap/pmap_data.h b/osfmk/arm/pmap/pmap_data.h
index 2883f63..7218e6f 100644
--- a/osfmk/arm/pmap/pmap_data.h
+++ b/osfmk/arm/pmap/pmap_data.h
@@ -74,7 +74,16 @@ extern pmap_paddr_t vm_first_phys, vm_last_phys;
 static inline bool
 pa_valid(pmap_paddr_t pa)
 {
-	return (pa >= vm_first_phys) && (pa < vm_last_phys);
+	if (__probable((pa >= vm_first_phys) && (pa < vm_last_phys))) {
+		return true;
+	}
+	/* HakiOS (patch 1512): the boot loader's extra RAM beside the window (arm/pmap/pmap.h) is kernel-managed too */
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pa >= hakios_extra_ram[i].pa) && (pa < hakios_extra_ram[i].end)) {
+			return true;
+		}
+	}
+	return false;
 }
 
 /**
@@ -97,9 +106,33 @@ pa_valid(pmap_paddr_t pa)
 static inline unsigned int
 pa_index(pmap_paddr_t pa)
 {
+	if (__probable((pa >= vm_first_phys) && (pa < vm_last_phys))) {
+		return (unsigned int)atop(pa - vm_first_phys);
+	}
+	/* HakiOS (patch 1512): an extra range's pages come after the window's, in the order of the ranges */
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pa >= hakios_extra_ram[i].pa) && (pa < hakios_extra_ram[i].end)) {
+			return hakios_extra_ram[i].pai + (unsigned int)atop(pa - hakios_extra_ram[i].pa);
+		}
+	}
 	return (unsigned int)atop(pa - vm_first_phys);
 }
 
+/**
+ * The physical address of a physical address index (the reverse of pa_index()).
+ */
+static inline pmap_paddr_t
+pai_to_pa(unsigned int pai)
+{
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pai >= hakios_extra_ram[i].pai) &&
+		    (pai - hakios_extra_ram[i].pai < atop(hakios_extra_ram[i].end - hakios_extra_ram[i].pa))) {
+			return hakios_extra_ram[i].pa + ptoa((pmap_paddr_t)(pai - hakios_extra_ram[i].pai));
+		}
+	}
+	return vm_first_phys + ptoa((pmap_paddr_t)pai);
+}
+
 /* See the definition of pv_head_table for more information. */
 extern pv_entry_t **pv_head_table;
 
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index cd7cc4c..1db05ee 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -364,8 +364,135 @@ typedef struct {
 
 #define PTOV_TABLE_SIZE 8
 SECURITY_READ_ONLY_LATE(static ptov_table_entry)        ptov_table[PTOV_TABLE_SIZE];
+/*
+ * redfin (1054): the extra RAM's aperture entries, in a table of their own (HakiOS 1512 grew ptov_table instead), so
+ * that with xram=0 ptov_table, ARM64_PHYSMAP_ALIGNMENT_PADDING and the physmap sizing are exactly as before.
+ * Looked up only when hakios_extra_ram_count != 0.
+ */
+SECURITY_READ_ONLY_LATE(static ptov_table_entry)        sweet_xram_ptov[HAKIOS_EXTRA_RAM_MAX];
 SECURITY_READ_ONLY_LATE(static boolean_t)               kva_active = FALSE;
 
+/*
+ * HakiOS (patch 1512): the boot loader's extra RAM beside the window (arm/pmap/pmap.h). Read once in arm_vm_init(),
+ * before anything is sized from the memory there is. redfin (1054): from the table below, boot-arg xram=N (default 0).
+ */
+SECURITY_READ_ONLY_LATE(hakios_extra_ram_t) hakios_extra_ram[HAKIOS_EXTRA_RAM_MAX];
+SECURITY_READ_ONLY_LATE(unsigned int) hakios_extra_ram_count = 0;
+SECURITY_READ_ONLY_LATE(unsigned int) hakios_extra_ram_pages = 0;
+SECURITY_READ_ONLY_LATE(static unsigned int) hakios_extra_ram_refused = 0;
+
+/*
+ * redfin (1054): the free RAM of the low bank, which XNU's window (0x100000000 + 6 GiB - 20 MiB, mkadt.py --highmem,
+ * 1033) leaves out. Live DT (TWRP recon 2026-10-23) memory <0x80000000 0x3bb00000>: /proc/iomem's "System RAM"
+ * pieces between the no-map carve-outs, 16 KB aligned, without the 1 MB and 428 KB slivers next to hyp/aop/smem.
+ * Kept out: hyp, xbl_aop, cmd-db, uefi log, sec_apps, smem, removed_region, qtee_apps (TZ/hyp), pil_camera,
+ * pil_adsp, pil_wlan_fw, ipa, pil_gpu (zap), reserved_pil_mem, modem_wlan (MPSS + rmtfs), cdsp_sec, cont_splash
+ * (ABL's autorefresh scans it out), dfps_data, debug_info, ramoops, alt_ramoops, ramoops_meta, ramdumplog.
+ * The loader's payload, ABL's DTB and the shim itself sit in 0xa2400000-0xb7e00000 but are dead once XNU runs
+ * (everything is copied into the window, shim/loader.c).
+ *   xram=1  System RAM only                                                         459.7 MB
+ *   xram=2  plus pil_npu + pil_video + pil_cdsp (firmware we never load; +40 MB)    499.7 MB
+ * Default 0: no extra RAM, as before.
+ * With boot-arg sweetvenus non-zero (the video track, 1057: Venus queues at 0xa2600000, buffer window 0xa2a00000 +
+ * 160 MB, firmware in pil_video) the ranges marked venus are left out: 0xa2600000-0xaca00000 and pil_video
+ * (xram=1 295.7 MB, xram=2 330.7 MB). xram=3 / xram=4 = xram=1 / xram=2 with the Venus ranges left out too, for a
+ * cmdline with no room for sweetvenus= (Venus then switched on live with kern.sweet_venus).
+ */
+static const struct { uint64_t pa, end; unsigned int tier; bool venus; } sweet_xram_ranges[] = {
+	{ 0x084400000ULL, 0x086000000ULL, 1, false },   /* 28 MB, between qtee_apps and pil_camera */
+	{ 0x086500000ULL, 0x086a00000ULL, 2, false },   /* 5 MB, pil_npu */
+	{ 0x086a00000ULL, 0x086f00000ULL, 2, true },    /* 5 MB, pil_video (Venus firmware with sweetvenus) */
+	{ 0x086f00000ULL, 0x087400000ULL, 1, false },   /* 5 MB, between pil_video and pil_cdsp */
+	{ 0x087400000ULL, 0x089200000ULL, 2, false },   /* 30 MB, pil_cdsp */
+	{ 0x09d800000ULL, 0x09f400000ULL, 1, false },   /* 28 MB, between modem_wlan and cdsp_sec */
+	{ 0x0a2400000ULL, 0x0a2600000ULL, 1, false },   /* 2 MB, after dfps_data */
+	{ 0x0a2600000ULL, 0x0aca00000ULL, 1, true },    /* 164 MB, Venus queues + buffer window with sweetvenus */
+	{ 0x0aca00000ULL, 0x0b7e00000ULL, 1, false },   /* 180 MB, up to debug_info */
+	{ 0x0b8654000ULL, 0x0bbb00000ULL, 1, false },   /* 52.7 MB, between ramdumplog and the end of the bank */
+};
+SECURITY_READ_ONLY_LATE(static uint32_t) sweet_xram_tier = 0;
+SECURITY_READ_ONLY_LATE(static uint32_t) sweet_xram_venus = 0;
+
+static void
+hakios_extra_ram_init(void)
+{
+	unsigned int first_pai = (unsigned int)atop(mem_size);
+	uint32_t tier = 0;
+
+	if (!PE_parse_boot_argn("xram", &tier, sizeof(tier)) || tier == 0) {
+		return;
+	}
+	sweet_xram_tier = tier;
+	if (!PE_parse_boot_argn("sweetvenus", &sweet_xram_venus, sizeof(sweet_xram_venus))) {
+		sweet_xram_venus = 0;
+	}
+	if (tier >= 3) {                /* 3 = 1, 4 = 2, both without the Venus ranges */
+		tier -= 2;
+		if (sweet_xram_venus == 0) {
+			sweet_xram_venus = 0x100;       /* (kept out because of xram=3/4, not the boot-arg) */
+		}
+	}
+	/* only on the redfin map: the window above 4 GiB (otherwise these ranges could be the window's or no RAM at all) */
+	if (gPhysBase != 0x100000000ULL) {
+		hakios_extra_ram_refused = (unsigned int)-1;
+		return;
+	}
+	for (unsigned int i = 0; i < sizeof(sweet_xram_ranges) / sizeof(sweet_xram_ranges[0]) &&
+	    hakios_extra_ram_count < HAKIOS_EXTRA_RAM_MAX; i++) {
+		if (sweet_xram_ranges[i].tier > tier || (sweet_xram_ranges[i].venus && sweet_xram_venus != 0)) {
+			continue;
+		}
+		pmap_paddr_t pa = round_page(sweet_xram_ranges[i].pa), end = trunc_page(sweet_xram_ranges[i].end);
+		bool ok = end > pa;
+
+		/* never the window, nor another range */
+		if (ok && pa < gPhysBase + real_phys_size && end > gPhysBase) {
+			ok = false;
+		}
+		for (unsigned int j = 0; ok && j < hakios_extra_ram_count; j++) {
+			ok = !(pa < hakios_extra_ram[j].end && end > hakios_extra_ram[j].pa);
+		}
+		if (!ok) {
+			hakios_extra_ram_refused++;     /* (said in arm_vm_prot_finalize(): too early for printf here) */
+			continue;
+		}
+		/* a range that starts where the last one ended joins it (one ptov entry) */
+		if (hakios_extra_ram_count != 0 && hakios_extra_ram[hakios_extra_ram_count - 1].end == pa) {
+			hakios_extra_ram[hakios_extra_ram_count - 1].end = end;
+		} else {
+			hakios_extra_ram[hakios_extra_ram_count].pa = pa;
+			hakios_extra_ram[hakios_extra_ram_count].end = end;
+			hakios_extra_ram[hakios_extra_ram_count].pai = first_pai + hakios_extra_ram_pages;
+			hakios_extra_ram_count++;
+		}
+		hakios_extra_ram_pages += (unsigned int)atop(end - pa);
+	}
+}
+
+/* [pa, pa + len) is all in one of the extra ranges */
+static bool
+hakios_extra_ram_covers(pmap_paddr_t pa, pmap_paddr_t len)
+{
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if (pa >= hakios_extra_ram[i].pa && pa + len <= hakios_extra_ram[i].end) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* [pa, pa + len) meets one of the extra ranges */
+static bool
+hakios_extra_ram_meets(pmap_paddr_t pa, pmap_paddr_t len)
+{
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if (pa < hakios_extra_ram[i].end && pa + len > hakios_extra_ram[i].pa) {
+			return true;
+		}
+	}
+	return false;
+}
+
 
 vm_map_address_t
 phystokv(pmap_paddr_t pa)
@@ -376,6 +503,11 @@ phystokv(pmap_paddr_t pa)
 			return pa - ptov_table[i].pa + ptov_table[i].va;
 		}
 	}
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {      /* (1054; none with xram=0) */
+		if ((pa >= sweet_xram_ptov[i].pa) && (pa < (sweet_xram_ptov[i].pa + sweet_xram_ptov[i].len))) {
+			return pa - sweet_xram_ptov[i].pa + sweet_xram_ptov[i].va;
+		}
+	}
 	if (__improbable((pa < gPhysBase) || ((pa - gPhysBase) >= real_phys_size))) {
 		panic("%s: illegal PA: 0x%llx; phys base 0x%llx, size 0x%llx", __func__,
 		    (unsigned long long)pa, (unsigned long long)gPhysBase, (unsigned long long)real_phys_size);
@@ -397,6 +529,15 @@ phystokv_range(pmap_paddr_t pa, vm_size_t *max_len)
 			return pa - ptov_table[i].pa + ptov_table[i].va;
 		}
 	}
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {      /* (1054; none with xram=0) */
+		if ((pa >= sweet_xram_ptov[i].pa) && (pa < (sweet_xram_ptov[i].pa + sweet_xram_ptov[i].len))) {
+			len = sweet_xram_ptov[i].len - (pa - sweet_xram_ptov[i].pa);
+			if (*max_len > len) {
+				*max_len = len;
+			}
+			return pa - sweet_xram_ptov[i].pa + sweet_xram_ptov[i].va;
+		}
+	}
 	len = PAGE_SIZE - (pa & PAGE_MASK);
 	if (*max_len > len) {
 		*max_len = len;
@@ -416,6 +557,11 @@ ml_static_vtop(vm_offset_t va)
 			return va - ptov_table[i].va + ptov_table[i].pa;
 		}
 	}
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {      /* (1054; none with xram=0) */
+		if ((va >= sweet_xram_ptov[i].va) && (va < (sweet_xram_ptov[i].va + sweet_xram_ptov[i].len))) {
+			return va - sweet_xram_ptov[i].va + sweet_xram_ptov[i].pa;
