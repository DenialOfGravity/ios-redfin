+/*
+ * 1277: kern.sweet_rpmh_tcs (default 0 = unchanged). The "TCS0 in flight" timeouts of 2026-11-20 (venus MM3/MM2 at
+ * power on / resume) end with the TCS idle and every CMD_STATUS ISSUED|COMPLETE, the same state every completed vote
+ * leaves: the vote had completed. done=0 came from the completion test: this driver masks the TCS's IRQ, IRQ_STATUS
+ * then never sets (77 of 77 completed votes that day read irq=0), so completion rests on seeing the TCS busy or a
+ * CMD_STATUS not complete at least once ("progress"). If the thread is interrupted or preempted between the trigger
+ * write and its first poll for longer than the vote takes (camera start, GPU busy), it only sees the end state, which
+ * reads exactly like the stale state of the previous vote in that TCS: no progress, 100000 polls (~2.6 s), quarantine.
+ *   bit 0 (1): the trigger write and the first polls (until progress, at most RH_FAST_US) with interrupts off, so the
+ *              first poll follows the trigger within one register read.
+ *   bit 1 (2): an ambiguous state (idle + every command complete, no progress seen) for RH_AMBIG_POLLS polls is
+ *              re-triggered (same commands: ACTIVE writes of absolute values, idempotent) up to RH_RETRIG_N times,
+ *              instead of waiting out the timeout.
+ *   bit 2 (4): still ambiguous after those re-triggers: accepted as completed (klog line) instead of the quarantine.
+ * kern.sweet_rpmh_tcs_test (RW, default 0, test only): busy-wait N us (max 5000) between the first trigger of a vote
+ * and its first poll (BCM votes only, not with bit 0): the preemption window, made on purpose, to reproduce the false
+ * timeout.
+ * kern.sweet_rpmh_tcs_stats (RD): votes, fast-seen (bit 0 saw progress), ambiguous, re-triggers, accepted, timeouts,
+ * gapmax (longest trigger -> first poll, us, without bit 0).
+ */
+#define RH_FAST_US      50u
+#define RH_AMBIG_POLLS  40u      /* ~1 ms at the ~26 us that delay(1) takes here */
+#define RH_RETRIG_N     3u
+static unsigned rh_tcsmode, rh_tcstest;
+static unsigned rh_tcs_votes, rh_tcs_fastseen, rh_tcs_ambig, rh_tcs_retrig, rh_tcs_accept, rh_tcs_tmo, rh_tcs_gapmax;
+static uint64_t rh_fast_abs;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_rpmh_tcs, CTLFLAG_RW | CTLFLAG_LOCKED, &rh_tcsmode, 0,
+    "1277: AMC completion: 1 trigger+first polls with IRQs off | 2 re-trigger an ambiguous end state | 4 then accept it");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_rpmh_tcs_test, CTLFLAG_RW | CTLFLAG_LOCKED, &rh_tcstest, 0,
+    "1277 test: busy-wait N us between the trigger and the first poll (not with kern.sweet_rpmh_tcs bit 0)");
+
+static int
+sysctl_sweet_rpmh_tcs_stats SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[192];
+	snprintf(buf, sizeof(buf), "tcs=%u test=%u votes=%u fast-seen=%u ambiguous=%u retrig=%u accepted=%u timeouts=%u "
+	    "gapmax_us=%u",
+	    __atomic_load_n(&rh_tcsmode, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcstest, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcs_votes, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcs_fastseen, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcs_ambig, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcs_retrig, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcs_accept, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcs_tmo, __ATOMIC_RELAXED),
+	    __atomic_load_n(&rh_tcs_gapmax, __ATOMIC_RELAXED));
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_rpmh_tcs_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0,
+    sysctl_sweet_rpmh_tcs_stats, "A", "1277: AMC completion counters");
+
+static unsigned
+rh_abs_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000 > 0xffffffffull ? 0xffffffffu : (unsigned)(ns / 1000);
+}
+
 static bool
 rh_free(unsigned t)
 {
@@ -366,43 +426,130 @@ rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32
 	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
 		return EIO;
 	}
-	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
 	uint32_t irq = 0, idle = 0, status[4] = {0, 0, 0, 0};
