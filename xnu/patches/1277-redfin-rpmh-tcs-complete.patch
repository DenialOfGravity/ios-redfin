-			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
-			complete &= status[c] != 0xffffffffu &&
-			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
-		}
-		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
-		progress |= idle == 0 || !complete;
-		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
-		    ((irq & bit) || progress) && complete) {
+	bool done = false, progress = false, ambiguous = false, retrig_sync_err = false;
+	unsigned mode = rh_tcsmode, retrig = 0, gap_us = 0;     /* 1277 */
+	if (!rh_fast_abs) {
+		nanoseconds_to_absolutetime(RH_FAST_US * 1000ull, &rh_fast_abs);
+	}
+	rh_tcs_votes++;
+trigger:
+	progress = false;
+	ambiguous = false;
+	{
+		uint64_t t0, t1 = 0;
+		if (mode & 1u) {                        /* 1277 bit 0: no interrupt/preemption between trigger and poll */
+			boolean_t was = ml_set_interrupts_enabled(FALSE);
+			rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+			t0 = mach_absolute_time();
+			for (;;) {
+				uint32_t st = rh_read(rh_tcs, b + RH_STATUS);
+				bool cpl = st != 0xffffffffu;
+				for (unsigned c = 0; c < n && cpl; ++c) {
+					uint32_t cs = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+					cpl = cs != 0xffffffffu && (cs & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+				}
+				if (!t1) {
+					t1 = mach_absolute_time();
+				}
+				if (st == 0 || !cpl) {
+					progress = true;
+					break;
+				}
+				if (mach_absolute_time() - t0 >= rh_fast_abs) {
+					break;
+				}
+			}
+			ml_set_interrupts_enabled(was);
+			if (progress) {
+				rh_tcs_fastseen++;
+			}
+		} else {
+			rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+			t0 = mach_absolute_time();
+			if (rh_tcstest && !retrig && (address >> 16) == RH_BCM) {  /* 1277 test: the window, BCMs only */
+				delay(rh_tcstest > 5000u ? 5000u : rh_tcstest);
+			}
+		}
+		unsigned still = 0;
+		for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+			irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+			idle = rh_read(rh_tcs, b + RH_STATUS);
+			bool complete = true;
+			for (unsigned c = 0; c < n; ++c) {
+				status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+				complete &= status[c] != 0xffffffffu &&
+				    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+			}
+			if (!t1) {
+				t1 = mach_absolute_time();
+				gap_us = rh_abs_us(t1 - t0);
+				if (gap_us > rh_tcs_gapmax) {
+					rh_tcs_gapmax = gap_us;
+				}
+			}
+			/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+			progress |= idle == 0 || !complete;
+			if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+			    ((irq & bit) || progress) && complete) {
+				done = true;
+				break;
+			}
+			/* 1277 bit 1: idle + complete and never a transition: the end state or a stale one, unknowable */
+			if ((mode & 2u) && idle && idle != 0xffffffffu && complete && ++still >= RH_AMBIG_POLLS) {
+				ambiguous = true;
+				break;
+			}
+			delay(1);
+		}
+		if (mode & 1u) {
+			gap_us = rh_abs_us(t1 - t0);
+		}
+	}
+	if (!done && ambiguous) {                       /* 1277 */
+		rh_tcs_ambig++;
+		if (retrig < RH_RETRIG_N) {
+			retrig++;
+			rh_tcs_retrig++;
+			printf("SWEET RPMH: 1277: TCS%u at %#x idle + complete with no transition seen (first poll %u us after "
+			    "the trigger): re-trigger %u of %u\n", t, address, gap_us, retrig, RH_RETRIG_N);
+			if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+			    !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+				retrig_sync_err = true;
+				printf("SWEET RPMH: 1277: TCS%u at %#x re-trigger control sync failed\n", t, address);
+			} else {
+				goto trigger;
+			}
+		}
+		if (!retrig_sync_err && (mode & 4u)) {
+			rh_tcs_accept++;
+			printf("SWEET RPMH: 1277: TCS%u at %#x still idle + complete without a transition after %u re-triggers: "
+			    "accepted as completed\n", t, address, retrig);
 			done = true;
-			break;
 		}
-		delay(1);
+	} else if (done && retrig) {
+		printf("SWEET RPMH: 1277: TCS%u at %#x completed after re-trigger %u (first poll %u us after the trigger)\n",
+		    t, address, retrig, gap_us);
 	}
 	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
 	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
 	if (!done) {
 		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		rh_tcs_tmo++;
+		printf("SWEET RPMH: 1277: first poll %u us after the trigger, progress %d, re-triggers %u, "
+		    "kern.sweet_rpmh_tcs=%u (1 IRQs off at the trigger, 2 re-trigger, 4 accept)\n", gap_us, progress, retrig, mode);
 		if (rh_q_tcs < 0 && n <= 4 && !prev_hard) {   /* 1135: a clean timeout, the first one */
 			rh_q_tcs = (int)t;
 			rh_q_n = n;
 			rh_q_addr = address;
 			rh_q_irqbit = irq_en & bit;
 			for (unsigned c = 0; c < n; ++c) {
 				rh_q_off[c] = offsets[c];
 				rh_q_val[c] = values[c];
 			}
 			rh_q_hard = false;
 			printf("SWEET RPMH: 1135: TCS%u in flight at %#x; kern.sweet_rpmh_recover=%u (1 reclaim on late "
 			    "completion, 2 use the other ACTIVE TCS)\n", t, address, rh_recover);
 		}
-		return ETIMEDOUT;
+		return retrig_sync_err ? EIO : ETIMEDOUT;
 	}
