From a71c0d35cad556ffd2ab1505a6a8cbd6fff83cec Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 02:42:33 +0100
Subject: [PATCH 1/2] 1104 redfin: scanout gate only on display-writing submits
 (NativeAdrenoAbiSubmit.flags, kern.sweet_scangate_flag)

NativeAdrenoAbiSubmit.reserved becomes a union { reserved; flags; } (both names
valid); bit 0 NativeAdrenoAbiSubmitWritesDisplay is accepted by the v2 submit,
any other bit is refused as before. hakios-metal HM_GATE_FLAG=1 sets it on a
submission that writes a display-sized imported IOSurface.

kern.sweet_scangate_flag (default 1): once a process has flagged a submission,
the scanout gate (p scanout gate 1|2) holds only its flagged ones; its bare
submissions (offscreen passes, compute, XR/YCbCr pre-buffers) go to the ring at
once. A process that never flagged is gated in full as before. 0 = flag
ignored. 5 s gate line: flag display / bare / unflagged counts.
---
 bsd/dev/sweet_gpu.c                   | 31 ++++++++++++++++++++++++---
 iokit/Kernel/arm/SweetAccelerator.cpp |  8 ++++---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 25 +++++++++++++++------
 iokit/Kernel/arm/SweetGPUABI.h        |  7 +++++-
 4 files changed, 58 insertions(+), 13 deletions(-)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 4ce7789..10c1060 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -2549,7 +2549,22 @@ sweet_gpu_unmap_at(uint64_t iova, uint64_t len)
 	lck_mtx_unlock(&sweet_gpu_lock);
 }
 
-uint32_t sweet_scan_submit_gate(void);         /* 0985: SweetFramebuffer.cpp; 0989: a GPU-side wait's reference */
+uint32_t sweet_scan_submit_gate(uint32_t gf);  /* 0985: SweetFramebuffer.cpp; 0989: a GPU-side wait's reference; 1104: gf */
+
+/*
+ * 1104: kern.sweet_scangate_flag 0|1 (default 1). A v2 submission may carry NativeAdrenoAbiSubmit.flags bit 0
+ * (NativeAdrenoAbiSubmitWritesDisplay: hakios-metal HM_GATE_FLAG=1 sets it on a submission that writes the display
+ * surface). With 1, once a process has sent one flagged submission, the scanout gate (p scanout gate 1|2|3) holds only
+ * its flagged submissions: its offscreen passes, compute and pre-buffers go into the ring at once. A process that never
+ * flagged (Turnip, hm without HM_GATE_FLAG, every kernel client) is gated as before (all of the swapper's submits).
+ * 0 = the flag is ignored (accepted, every submission of the swapper gated as before 1104).
+ * The flagged process is one pid (the newest that flagged): only the swapper (backboardd) is ever gated, and a new
+ * backboardd is gated in full until its first flagged submission.
+ */
+int sweet_scangate_flag = 1;
+static volatile int scangate_flag_pid = -1;
+SYSCTL_INT(_kern, OID_AUTO, sweet_scangate_flag, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_scangate_flag, 0,
+    "SWEET SCANOUT: gate only display-writing submits of processes that flag them (1104, default 1)");
 
 /*
  * 0989: the direct scanout's "latched frame" word (scratch + A6_SCAN_WORD_OFF), which gated submits make the CP wait
@@ -2615,7 +2630,7 @@ sweet_gpu_ibmax(void)
 
 /* Queue up to kern.sweet_gpu_ibmax IBs: the fence, 0 when the GPU is not usable, or 0 with *busy when the ring is full. */
 uint32_t
-sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
+sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, uint32_t flags, bool *busy)
 {
 	*busy = false;
 	if (!gpu_ready) {
@@ -2629,7 +2644,17 @@ sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bo
 	/* 0985: CA's next frame waits for its last one on screen (direct scanout): here (gate 1) or in the CP (0989, gate 2) */
 	int pid = proc_selfpid();
 	SWEET_TRACE_START(SWT_GPU_SUBMIT, pid, n, 0, 0);     /* 0994 */
-	uint32_t wait_ref = sweet_scan_submit_gate();
+	/* 1104: gf bit 0 = writes the display (the client's flag), bit 1 = this pid flags its display submits */
+	uint32_t gf = flags & 1u;
+	if (sweet_scangate_flag) {
+		if (gf) {
+			scangate_flag_pid = pid;
+		}
+		if (pid == scangate_flag_pid) {
+			gf |= 2u;
+		}
+	}
+	uint32_t wait_ref = sweet_scan_submit_gate(gf);
 	lck_mtx_lock(&sweet_gpu_lock);
 	gpu_note_submit_locked();
 	uint64_t gpu_ticks = 0;
diff --git a/iokit/Kernel/arm/SweetAccelerator.cpp b/iokit/Kernel/arm/SweetAccelerator.cpp
index 4dd1e62..2a68e53 100644
--- a/iokit/Kernel/arm/SweetAccelerator.cpp
+++ b/iokit/Kernel/arm/SweetAccelerator.cpp
@@ -44,6 +44,7 @@
 #include "SweetSurface.h"
 #include "SweetGPUABI.h"
 #include "SweetTrace.h"     /* 0994 */
+#define SWEET_V2_SUBMIT_FLAGS   NativeAdrenoAbiSubmitWritesDisplay      /* 1104: the submit flags this kernel takes */
 #define SWEET_V2_IB_HW  128     /* 1038: = A6_SUBMIT_MAX_HW (bsd/dev/sweet_a6xx.h) */
 
 extern "C" {
@@ -61,7 +62,7 @@ int sweet_gpu_window_alloc(uint64_t *base, uint64_t *size);
 void sweet_gpu_window_free(uint64_t base);
 int sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages);
 void sweet_gpu_unmap_at(uint64_t iova, uint64_t len);
-uint32_t sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy);
+uint32_t sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, uint32_t flags, bool *busy);  /* 1104: flags */
 unsigned sweet_gpu_ibmax(void);         /* 1038: kern.sweet_gpu_ibmax */
 int sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns);
 bool sweet_gpu_lost(uint64_t *epoch, uint32_t last_fence);
@@ -1138,7 +1139,8 @@ SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t i
 		}
 		uint32_t nbuf = rq->buffer_count;
 		uint32_t extra = nbuf > NativeAdrenoAbiMaxBuffers ? nbuf - NativeAdrenoAbiMaxBuffers : 0;
-		if (nbuf == 0 || nbuf > nmax || nbuf > SWEET_V2_IB_HW || rq->reserved ||
+		/* 1104: flags bit 0 (NativeAdrenoAbiSubmitWritesDisplay) accepted, any other bit refused as before */
+		if (nbuf == 0 || nbuf > nmax || nbuf > SWEET_V2_IB_HW || (rq->flags & ~SWEET_V2_SUBMIT_FLAGS) ||
 		    inSize != sizeof(NativeAdrenoAbiSubmit) + extra * sizeof(NativeAdrenoAbiSubmitBuffer)) {
 			return kIOReturnBadArgument;
 		}
@@ -1159,7 +1161,7 @@ SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t i
 			return kIOReturnTimeout;
 		}
 		bool busy = false;
-		uint32_t fence = sweet_gpu_submit_v2(iova, dw, nbuf, &busy);
+		uint32_t fence = sweet_gpu_submit_v2(iova, dw, nbuf, rq->flags, &busy);
 		if (fence == 0) {
 			v2_err_log("submit", busy ? "busy (ring full)" : "not ready (GPU down)");
 			return busy ? kIOReturnBusy : kIOReturnNotReady;
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index b4f4cf6..965f027 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -3093,6 +3093,7 @@ static struct {
 	volatile uint64_t gateSeq;
 	uint64_t      stGateAbs;
 	uint32_t      stGate, stGateWait, stGateTimeout;
+	uint32_t      stFlagDisp, stFlagBare, stUnflagged;      /* 1104: the swapper's submits flagged display / bare (not gated) / from a process that never flagged */
 	bool          geom;             /* the pipes are in the scaled direct geometry (fLock) */
 	bool          entering;
 	bool          thread;
@@ -3449,14 +3450,24 @@ sweet_scan_swap(AppleCLCD *fb, const uint8_t *rec, uint64_t now, uint32_t fence)
  * SwapEnd K waits until frame K is on screen (30 ms at most). K's own work is in the ring before its SwapEnd (0949),
  * so this cannot hold up K's fence.
  */
-extern "C" uint32_t sweet_scan_submit_gate(void);
+/*
+ * 1104: gf (sweet_gpu.c, kern.sweet_scangate_flag): bit 0 the submission writes the display surface, bit 1 its process
+ * flags its display submissions. A bare submission (bit 1 without bit 0) of the swapper is not gated: offscreen passes,
+ * compute, pre-buffers. Counted in the 5 s gate line (flag display / bare / unflagged).
+ */
+extern "C" uint32_t sweet_scan_submit_gate(uint32_t gf);
 uint32_t
-sweet_scan_submit_gate(void)
+sweet_scan_submit_gate(uint32_t gf)
 {
 	AppleCLCD *fb = sweet_fb_instance;
 	if (!sweet_scan.on || !sweet_scan.geom || sweet_scan.gate == 0 || fb == NULL || proc_selfpid() != sweet_scan.gatePid) {
 		return 0;
 	}
+	if ((gf & 3u) == 2u) {
+		OSIncrementAtomic((volatile SInt32 *)&sweet_scan.stFlagBare);     /* 1104: not the display: never gated */
+		return 0;
+	}
+	OSIncrementAtomic((volatile SInt32 *)((gf & 1u) ? &sweet_scan.stFlagDisp : &sweet_scan.stUnflagged));
 	IOLockLock(fb->fLock);
 	sweet_scan.stGate++;
 	SWEET_TRACE(SWT_GPU_GATE, sweet_scan.gate, sweet_scan.gateSeq, sweet_scan.shownSeq, sweet_scan.word);      /* 0994 */
@@ -3868,10 +3879,12 @@ sweet_scan_stats_locked(uint64_t now)
 		uint64_t cw = 0;    /* 0986 */
 		absolutetime_to_nanoseconds(sweet_scan.stCornerAbs, &cw);
 		IOLog("SWEET SCANOUT: 5s gate %u: submits %u waited %u (avg %llu us) timeout %u | cp waits %u released %u queued %u "
-		    "overflow %u | corners %u (avg %llu us)\n", sweet_scan.gate, sweet_scan.stGate, sweet_scan.stGateWait,
-		    sweet_scan.stGateWait ? gw / 1000 / sweet_scan.stGateWait : 0, sweet_scan.stGateTimeout, sweet_scan.stGpuWait,
-		    sweet_scan.stGpuRelease, sweet_scan.stQueued, sweet_scan.stOverflow, sweet_scan.stCorners,
-		    sweet_scan.stCorners ? cw / 1000 / sweet_scan.stCorners : 0);
+		    "overflow %u | corners %u (avg %llu us) | flag display %u bare %u unflagged %u\n", sweet_scan.gate, sweet_scan.stGate,
+		    sweet_scan.stGateWait, sweet_scan.stGateWait ? gw / 1000 / sweet_scan.stGateWait : 0, sweet_scan.stGateTimeout,
+		    sweet_scan.stGpuWait, sweet_scan.stGpuRelease, sweet_scan.stQueued, sweet_scan.stOverflow, sweet_scan.stCorners,
+		    sweet_scan.stCorners ? cw / 1000 / sweet_scan.stCorners : 0, sweet_scan.stFlagDisp, sweet_scan.stFlagBare,
+		    sweet_scan.stUnflagged);
+		sweet_scan.stFlagDisp = sweet_scan.stFlagBare = sweet_scan.stUnflagged = 0;     /* 1104 */
 		sweet_scan.stGpuWait = sweet_scan.stGpuRelease = sweet_scan.stQueued = sweet_scan.stOverflow = 0;
 		sweet_scan.stCornerAbs = 0;
 		sweet_scan.stCorners = 0;
diff --git a/iokit/Kernel/arm/SweetGPUABI.h b/iokit/Kernel/arm/SweetGPUABI.h
index 0c6e483..b778cd5 100644
--- a/iokit/Kernel/arm/SweetGPUABI.h
+++ b/iokit/Kernel/arm/SweetGPUABI.h
@@ -81,12 +81,17 @@ struct NativeAdrenoAbiSubmitBuffer {
 };
 struct NativeAdrenoAbiSubmit {
     uint32_t buffer_count;        /* 1..NativeAdrenoAbiMaxBuffers */
-    uint32_t reserved;            /* zero */
+    union {                       /* redfin 1104: was reserved (zero); both names stay valid */
+        uint32_t reserved;
+        uint32_t flags;           /* NativeAdrenoAbiSubmitWritesDisplay; kernels before 1104 refuse non-zero */
+    };
     uint64_t queue;               /* open queue; 0 is created by open() */
     uint64_t wait_fence;          /* zero or an earlier fence of this client */
     uint64_t wait_timeout_ns;     /* used only when wait_fence is nonzero */
     NativeAdrenoAbiSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
 };
+/* redfin 1104: NativeAdrenoAbiSubmit.flags bit 0: this submission writes a display (swap-chain) surface */
+#define NativeAdrenoAbiSubmitWritesDisplay 1u
 struct NativeAdrenoAbiMetadata {
     uint64_t handle;              /* object identity */
     uint32_t bytes;               /* set: length; get: requested capacity */
-- 
2.53.0

