From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 9 Nov 2026 20:49:26 +0000
Subject: [PATCH] 1062 redfin: one SPMI transaction lock for all sweet drivers
 (kern.sweet_spmi_lock), torch alarm probe retry + tsens fallback +
 kern.sweet_torch_reinit, keys read sanity check

---
 bsd/dev/sweet_cam.c     |   9 +-
 bsd/dev/sweet_cs35l41.c |   5 ++
 bsd/dev/sweet_haptic.c  |   5 ++
 bsd/dev/sweet_keys.c    |  71 ++++++++++++++--
 bsd/dev/sweet_spmi.c    |  72 ++++++++++++++++
 bsd/dev/sweet_spmi.h    |   9 ++
 bsd/dev/sweet_thermal.c |   8 ++
 bsd/dev/sweet_torch.c   | 176 +++++++++++++++++++++++++++++++++++-----
 8 files changed, 327 insertions(+), 28 deletions(-)

diff --git a/bsd/dev/sweet_cam.c b/bsd/dev/sweet_cam.c
index 9c29268..c021d45 100644
--- a/bsd/dev/sweet_cam.c
+++ b/bsd/dev/sweet_cam.c
@@ -55,6 +55,7 @@
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
 #include <vm/memory_types.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
@@ -250,15 +251,21 @@ spmi(unsigned sid, unsigned addr, bool write, uint8_t *val)
 		return -1;
 	}
 	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		int bus = sweet_spmi_bus_lock();        /* 1062 */
 		if (write) {
 			wr(ch, 0x10, *val);
 		}
 		wr(ch, 0x00, ((write ? 0u : 1u) << 27) | ((addr & 0xffu) << 4));
 		uint32_t st = 0;
+		uint8_t data = 0;
 		unsigned i;
 		for (i = 0; i < 1000 && !((st = rd(ch, 0x08)) & 1u); i++) {
 			delay(1);
 		}
+		if (i < 1000 && !write && !(st & 0xeu)) {
+			data = (uint8_t)rd(ch, 0x18);
+		}
+		sweet_spmi_bus_unlock(bus);
 		if (i == 1000) {
 			printf("SWEET CAM: spmi %x:%x timeout\n", sid, addr);
 			return -1;
@@ -271,7 +278,7 @@ spmi(unsigned sid, unsigned addr, bool write, uint8_t *val)
 			return -1;
 		}
 		if (!write) {
-			*val = (uint8_t)rd(ch, 0x18);
+			*val = data;
 		}
 		return 0;
 	}
