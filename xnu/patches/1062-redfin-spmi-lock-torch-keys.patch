diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 2cb21a5..2671939 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -14,6 +14,7 @@
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
@@ -33,6 +34,15 @@ static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
 static uint32_t keys_version, keys_last_status;
 static bool keys_started;
 static int keys_sleep_chan;
+/*
+ * 1062: a key change is reported only if the peripheral still reads back as itself: TYPE (0x04) and
+ * SUBTYPE (0x05) equal to what init read, and the RT_STS byte reads the same again. A read that raced
+ * another driver's (r5au1f: pon=0x9, volup 0x80) is dropped. Boot-arg sweetkeyscheck=0: off.
+ */
+static uint8_t keys_pon_type, keys_pon_sub, keys_gpio_type, keys_gpio_sub;
+static bool keys_pon_id, keys_gpio_id;
+static int keys_check = 1;
+static unsigned keys_dropped;
 
 static uint32_t
 keys_rd(vm_offset_t base, uint32_t off)
@@ -68,21 +78,40 @@ keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
 	}
 	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
 	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	bool ok = false;
+	int bus = sweet_spmi_bus_lock();        /* 1062 */
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
 	__asm__ volatile("dsb osh" ::: "memory");
 	for (unsigned i = 0; i < 1000; ++i) {
 		keys_last_status = keys_rd(keys_obs, off + 0x08u);
 		if (keys_last_status & 1u) {
-			if (keys_last_status & 0x0eu) {
-				return false;
+			if (!(keys_last_status & 0x0eu)) {
+				*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+				ok = true;
 			}
-			*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
-			return true;
+			break;
 		}
 		delay(1);
 	}
-	return false;
+	sweet_spmi_bus_unlock(bus);
+	return ok;
+}
+
+/* 1062: the peripheral's TYPE/SUBTYPE as init saw them, and the RT byte again equal to val */
+static bool
+keys_still(uint16_t apid, uint16_t base, uint16_t rt, bool known, uint8_t type, uint8_t sub, uint8_t val,
+    uint8_t *t, uint8_t *s, uint8_t *again)
+{
+	if (!keys_check) {
+		return true;
+	}
+	*t = *s = *again = 0xee;
+	if (!known) {   /* init could not confirm the identity: the second read alone */
+		return keys_read(apid, rt, again) && *again == val;
+	}
+	return keys_read(apid, base + 0x04u, t) && keys_read(apid, base + 0x05u, s) &&
+	       keys_read(apid, rt, again) && *t == type && *s == sub && *again == val;
 }
 
 static void
@@ -114,6 +143,25 @@ keys_thread(void *arg, wait_result_t result)
 		} else {
 			errors = 0;
 		}
+		/* 1062: a change only if the read is confirmed (keys_still) */
+		bool pchg = pok && (now[0] != state[0] || now[2] != state[2]), gchg = gok && now[1] != state[1];
+		uint8_t t, s, again;
+		if (pchg && !keys_still(keys_pon_apid, 0x0800u, KEYS_PON_RT, keys_pon_id, keys_pon_type, keys_pon_sub,
+		    pon, &t, &s, &again)) {
+			if (keys_dropped++ < 40) {
+				printf("SWEET KEYS: pon read %#x dropped: type %#x/%#x subtype %#x/%#x again %#x\n",
+				    pon, t, keys_pon_type, s, keys_pon_sub, again);
+			}
+			pok = false;
+		}
+		if (gchg && !keys_still(keys_gpio_apid, KEYS_GPIO_BASE, KEYS_GPIO_RT, keys_gpio_id, keys_gpio_type,
+		    keys_gpio_sub, gpio, &t, &s, &again)) {
+			if (keys_dropped++ < 40) {
+				printf("SWEET KEYS: volup read %#x dropped: type %#x/%#x subtype %#x/%#x again %#x\n",
+				    gpio, t, keys_gpio_type, s, keys_gpio_sub, again);
+			}
+			gok = false;
+		}
 		for (int k = 0; k < 3; ++k) {
 			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
 				state[k] = now[k];
@@ -136,6 +184,7 @@ sweet_keys_init(void)
 	}
 	keys_started = true;
 	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetkeyscheck", &keys_check, sizeof(keys_check));
 	if (!enabled) {
 		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
 		return;
@@ -176,6 +225,18 @@ sweet_keys_init(void)
 	if (!pok && !gok) {
 		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
 	}
+	/* 1062: the identity a later key change is checked against (two equal reads each) */
+	uint8_t t2 = 0, s2 = 0;
+	keys_pon_id = keys_read(keys_pon_apid, 0x0804u, &keys_pon_type) && keys_read(keys_pon_apid, 0x0805u, &keys_pon_sub) &&
+	    keys_read(keys_pon_apid, 0x0804u, &t2) && keys_read(keys_pon_apid, 0x0805u, &s2) &&
+	    t2 == keys_pon_type && s2 == keys_pon_sub;
+	keys_gpio_id = keys_gpio_apid != KEYS_NO_APID && keys_read(keys_gpio_apid, KEYS_GPIO_BASE + 0x04u, &keys_gpio_type) &&
+	    keys_read(keys_gpio_apid, KEYS_GPIO_BASE + 0x05u, &keys_gpio_sub) &&
+	    keys_read(keys_gpio_apid, KEYS_GPIO_BASE + 0x04u, &t2) && keys_read(keys_gpio_apid, KEYS_GPIO_BASE + 0x05u, &s2) &&
+	    t2 == keys_gpio_type && s2 == keys_gpio_sub && keys_gpio_type == 0x10;
+	printf("SWEET KEYS: check %s: pon type %#x subtype %#x%s, volup type %#x subtype %#x%s\n", keys_check ? "on" : "off",
+	    keys_pon_type, keys_pon_sub, keys_pon_id ? "" : " (unconfirmed)", keys_gpio_type, keys_gpio_sub,
+	    keys_gpio_id ? "" : " (unconfirmed)");
 	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
 	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 9243e51..e2303f9 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -22,10 +22,76 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <machine/machine_routines.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <kern/locks.h>
 #include <IOKit/IOLocks.h>
 #include <pexpert/pexpert.h>
 #include "sweet_spmi.h"
 
+/*
+ * 1062: the shared SPMI transaction lock (sweet_spmi.h). r5au1f's boot: sweet_keys.c and sweet_torch.c
+ * read at the same moment and got each other's bytes (keys pon=0x9 = the temperature alarm's TYPE,
+ * torch subtype 0x1): the torch refused to start and keys saw fake presses.
+ * kern.sweet_spmi_lock (boot-arg sweetspmilock, default 1): 0 = every driver on its own again.
+ * kern.sweet_spmi_lock_waits (RD): transfers that found the lock taken (= would have overlapped).
+ */
+static LCK_GRP_DECLARE(sp_bus_grp, "sweet_spmi_bus");
+static LCK_MTX_DECLARE(sp_bus_mtx, &sp_bus_grp);
+static int sp_bus_on = -1;
+static unsigned sp_bus_waits;
+
+int
+sweet_spmi_bus_lock(void)
+{
+	if (sp_bus_on < 0) {
+		int v = 1;
+		(void)PE_parse_boot_argn("sweetspmilock", &v, sizeof(v));
+		sp_bus_on = v != 0;
+		printf("SWEET SPMI: shared transaction lock %s (sweetspmilock=%d)\n", sp_bus_on ? "on" : "OFF", v);
+	}
+	if (!sp_bus_on) {
+		return 0;
+	}
+	if (!lck_mtx_try_lock(&sp_bus_mtx)) {
+		__atomic_fetch_add(&sp_bus_waits, 1u, __ATOMIC_RELAXED);
+		lck_mtx_lock(&sp_bus_mtx);
+	}
+	return 1;
+}
+
+void
+sweet_spmi_bus_unlock(int held)
+{
+	if (held) {
+		lck_mtx_unlock(&sp_bus_mtx);
+	}
+}
+
+static int
+sysctl_sweet_spmi_lock SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (sp_bus_on < 0) {
+		sweet_spmi_bus_unlock(sweet_spmi_bus_lock());   /* boot-arg default, logged once */
+	}
+	int value = sp_bus_on, changed = 0;
+	int error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value != 0 && value != 1) {
+		return EINVAL;
+	}
+	sp_bus_on = value;      /* a holder still unlocks with its own "held" */
+	printf("SWEET SPMI: shared transaction lock %s (sysctl)\n", value ? "on" : "OFF");
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_spmi_lock, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_spmi_lock, "I", "1062: one lock for all sweet SPMI transfers (0 = off)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_spmi_lock_waits, CTLFLAG_RD | CTLFLAG_LOCKED, &sp_bus_waits, 0,
+    "1062: SPMI transfers that waited for another driver's");
+
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 
 #define SP_CORE_PA 0x0c440000u
@@ -120,6 +186,7 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	}
 	unsigned off = 0x80u * apid;
 	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	int bus = sweet_spmi_bus_lock();        /* 1062 (lock order: sp_lock, then the bus lock) */
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
 	__asm__ volatile("dsb osh" ::: "memory");
@@ -127,15 +194,18 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 		uint32_t status = sp_rd(sp_obs, off + 0x08u);
 		if (status & 1u) {
 			if (status & 0x0eu) {
+				sweet_spmi_bus_unlock(bus);
 				IOLockUnlock(sp_lock);
 				return -1;
 			}
 			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			sweet_spmi_bus_unlock(bus);
 			IOLockUnlock(sp_lock);
 			return 0;
 		}
 		delay(1);
 	}
+	sweet_spmi_bus_unlock(bus);
 	sp_poisoned[apid] = true;
 	printf("SWEET BATTERY: SPMI timeout sid=%u addr=%#x APID=%u disabled\n",
 	    sid, addr, apid);
@@ -210,6 +280,7 @@ sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
 	}
 	uint32_t status = 0;
 	unsigned t;
+	int bus = sweet_spmi_bus_lock();        /* 1062 */
 	__asm__ volatile ("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(ch + 0x10u) = val;                       /* WDATA0 */
 	__asm__ volatile ("dmb oshst" ::: "memory");
@@ -222,6 +293,7 @@ sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
 		}
 		delay(1);
 	}
+	sweet_spmi_bus_unlock(bus);
 	if (!(status & 1u)) {
 		sp_poisoned[apid] = true;
 	}
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
index a04a1c5..84c0306 100644
--- a/bsd/dev/sweet_spmi.h
+++ b/bsd/dev/sweet_spmi.h
@@ -15,6 +15,15 @@ int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
  */
 int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val);
 int sweet_spmi_write_enabled(void);
+/*
+ * 1062: one lock for every SPMI transaction of every sweet driver (keys, torch, camera GPIOs, haptic,
+ * CS35L41 GPIOs, battery/charger/thermal/RTC here): command, status and data of one transfer can no
+ * longer interleave with another driver's. sweet_spmi_bus_lock() returns whether it took the lock
+ * (boot-arg sweetspmilock=0 or sysctl kern.sweet_spmi_lock=0: no lock, the old behaviour); pass that
+ * to sweet_spmi_bus_unlock(). Thread context only (a mutex; the transfers spin up to 1 ms).
+ */
+int sweet_spmi_bus_lock(void);
+void sweet_spmi_bus_unlock(int held);
 #ifdef __cplusplus
 }
 #endif
diff --git a/bsd/dev/sweet_thermal.c b/bsd/dev/sweet_thermal.c
index 22763cf..69b8e31 100644
