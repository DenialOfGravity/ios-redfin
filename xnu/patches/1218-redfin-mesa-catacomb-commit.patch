+/* 1218: master component blob (kernel only) */
+static uint64_t
+cat_unix_now(void)
+{
+	clock_sec_t sec = 0;
+	clock_usec_t usec = 0;
+	clock_get_calendar_microtime(&sec, &usec);
+	return (uint64_t)sec;
+}
+
+static uint32_t
+cat_fnv1a(const uint8_t *p, uint32_t n)
+{
+	uint32_t h = 0x811c9dc5u;
+	for (uint32_t i = 0; i < n; i++) {
+		h = (h ^ p[i]) * 0x01000193u;
+	}
+	return h;
+}
+
+static void
+cat_put64(uint8_t *p, uint64_t v)
+{
+	put32(p, (uint32_t)v);
+	put32(p + 4, (uint32_t)(v >> 32));
+}
+
+static uint64_t
+cat_le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | ((uint64_t)le32(p + 4) << 32);
+}
+
+static void
+cat_master_build(void)
+{
+	uint8_t *b = gCatMBlob;
+	bzero(b, SWCM_SIZE);
+	put32(b, SWCM_MAGIC);
+	b[4] = SWCM_VERSION;
+	b[6] = SWCM_SIZE;
+	put32(b + 8, cat_user());
+	put32(b + 12, (uint32_t)gCat);
+	cat_put64(b + 16, cat_unix_now());
+	put32(b + 24, cat_fnv1a(b, 24));
+}
