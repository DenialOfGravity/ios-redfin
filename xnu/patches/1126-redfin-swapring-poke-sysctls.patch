From 1ebe2ec126a076a05ee9e8fb6faf75a00e31b7c0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 10:57:00 +0100
Subject: [PATCH 1/2] 1126 redfin: kern.sweet_swapdone / kern.sweet_pace /
 kern.sweet_pace_min sysctls over the swap-ring pokes (write = p swapdone/p
 pace path; defaults unchanged)

---
 bsd/dev/sweet_gpu.c                   | 34 ++++++++++++++++++++++
 iokit/Kernel/arm/SweetFramebuffer.cpp | 41 +++++++++++++++++++++++++++
 2 files changed, 75 insertions(+)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 1ea492a..bd113dc 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1821,6 +1821,40 @@ sysctl_sweet_fb_early_retire SYSCTL_HANDLER_ARGS
 SYSCTL_PROC(_kern, OID_AUTO, sweet_fb_early_retire, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
     0, 0, sysctl_sweet_fb_early_retire, "I", "SWEET FB: early swap retire mask (1 tick, 2 rekick, 4 SwapWait poll)");
 
+/*
+ * 1126: sysctls over the swap-ring pokes (SweetFramebuffer.cpp), so SweetControl boot pins can hold them:
+ *   kern.sweet_swapdone   MASK, as p swapdone N / boot-arg sweetswapdone (0987: 1 tick at swap done, 2 trace); default 0
+ *   kern.sweet_pace       MODE, as p pace N / boot-arg sweetpace (0977/0984: &7 mode 0..3, 16 gate on queue); default 0
+ *   kern.sweet_pace_min   US,   as p pace MODE MIN / boot-arg sweetpace_min (0983); default 8000. 0 is refused
+ *                         (EINVAL): the poke reads MIN 0 as "keep"; the pace code clamps below 1000 us to 1000
+ * A write goes through the poke handler (fbCmd), so the pace timer/owed tick are handled exactly as for the poke.
+ * Unsigned decimal like the poke: negative values are refused.
+ */
+extern uint32_t sweet_fb_knob_get(int k);
+extern void sweet_fb_knob_set(int k, uint32_t v);
+static int
+sysctl_sweet_fb_knob SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1)
+	int k = arg2;
+	int value = (int)sweet_fb_knob_get(k), changed = 0;
+	int error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value < 0 || (k == 2 && value == 0)) {
+		return EINVAL;
+	}
+	sweet_fb_knob_set(k, (uint32_t)value);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_swapdone, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_fb_knob, "I", "SWEET FB: swapdone mask (1 tick at swap done, 2 trace) = p swapdone");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_pace, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 1, sysctl_sweet_fb_knob, "I", "SWEET FB: pace mode = p pace N");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_pace_min, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 2, sysctl_sweet_fb_knob, "I", "SWEET FB: pace min interval in us (>0) = p pace MODE MIN");
+
 /*
  * 1042: kern.sweet_vsync_lock 0|1 (default 0 = as before): 0995's vsync options as a runtime switch (the cmdline is full):
  * 1 = sweetvsync 7 + sweetfb_refresh 1 (SweetFramebuffer.cpp sweet_vlock): ticks without slop on the panel's measured
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index c9e183b..3dc9984 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -6360,6 +6360,47 @@ sweet_fb_cmd(const char *s, const char *end)
 	sweet_fb_instance->fbCmd(s, end);
 }
 
+/*
+ * 1126: kern.sweet_swapdone / kern.sweet_pace / kern.sweet_pace_min (bsd/dev/sweet_gpu.c) read the 0984/0987
+ * variables here and write them through fbCmd, the same code path as p swapdone N / p pace N [MIN_US] (so a pace
+ * change drops a pending mode-3 timer and releases an owed tick exactly as the poke does). Before the framebuffer
+ * has started (no instance) the variables are only stored; start() logs and uses them as for the boot-args.
+ *   k 0 swapdone, 1 pace (mode), 2 pace_min (us)
+ */
+extern "C" uint32_t sweet_fb_knob_get(int k);
+uint32_t
+sweet_fb_knob_get(int k)
+{
+	return k == 0 ? sweet_swapdone : k == 1 ? sweet_pace : sweet_pace_min;
+}
+
+extern "C" void sweet_fb_knob_set(int k, uint32_t v);
+void
+sweet_fb_knob_set(int k, uint32_t v)
+{
+	char cmd[40];
+	if (k == 0) {
+		snprintf(cmd, sizeof(cmd), "swapdone %u", v);
+	} else if (k == 1) {
+		snprintf(cmd, sizeof(cmd), "pace %u", v);       /* no MIN: the poke keeps sweet_pace_min */
+	} else {
+		snprintf(cmd, sizeof(cmd), "pace %u %u", sweet_pace, v);
+	}
+	if (sweet_fb_instance == NULL) {
+		if (k == 0) {
+			sweet_swapdone = v;
+		} else if (k == 1) {
+			sweet_pace = v;
+		} else {
+			sweet_pace_min = v;
+		}
+		IOLog("SWEET FB: 1126 sysctl %s (no framebuffer yet: stored)\n", cmd);
+		return;
+	}
+	IOLog("SWEET FB: 1126 sysctl -> p %s\n", cmd);
+	sweet_fb_instance->fbCmd(cmd, cmd + strlen(cmd));
+}
+
 /*
  * ---- 0944 (sweetfbx & 4): present at SwapEnd, ticks on the TE ----
  *
-- 
2.53.0

