 		}
-		hold_open(pipe, sess, repub_mode == 4 ? repub_ms : holddly, "BSP activation 0xb00c sent");
+		hold_open(pipe, sess, (repub_mode == 4 || repub_mode == 5) ? repub_ms : holddly, "BSP activation 0xb00c sent");
 	}
 }
 
