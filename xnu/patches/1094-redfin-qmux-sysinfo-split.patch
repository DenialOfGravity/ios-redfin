+/*
+ * ---- 1094: kern.sweet_qmi_republish = 5: as 4, plus a split release ----
+ * research/cc/M3-context-assign.md H/I. At the activation release CommCenter learned the PLMN (roaming state) 60 ms
+ * before it applied the data bearer, so the one settings reconfiguration that would mark the Internet connection
+ * current was skipped ("No data bearer available, not reconfiguring with kUnknown"). Mode 5 releases the held NAS
+ * Serving System 0x0024 and SysInfo 0x004e indications first WITHOUT their PLMN-carrying TLVs (the same ids as 1087's
+ * answer stripping; TLVs removed only, nothing synthesised or altered), every other held indication as it is, then
+ * after kern.sweet_qmi_split_ms (300) the modem's full held 0x0024/0x004e unchanged. No split (plain release, logged)
+ * if no held 0x0024 says PS attached (TLV 0x01 byte 2 == 1) and no held 0x004e says LTE service full (TLV 0x14 byte 0
+ * == 2). Logs "republish: split 1/2 (no PLMN) sent ..." and "republish: split 2/2 (full) sent ..." with TLV ids only.
+ */
+#define SPLIT_N 8
+static int split_ms = 300;
+static struct {
+	int n;
+	uint64_t at;
+	struct { uint32_t pipe, sess, n; uint8_t f[HOLD_MAXF]; } q[SPLIT_N];
+} spl;
+static uint8_t spl_buf[HOLD_MAXF];
+
+static void
+tlv_idlist(char *o, size_t ol, const uint8_t *p, uint32_t n)
+{
+	size_t k = 0;
+	o[0] = 0;
+	for (uint32_t i = 0; i + 3 <= n && k + 4 < ol;) {
+		k += (size_t)snprintf(o + k, ol - k, "%s%02x", i ? "," : "", p[i]);
+		i += 3u + (uint32_t)(p[i + 1] | (p[i + 2] << 8));
+	}
+}
+
+/* copy of frame f without the PLMN-carrying TLVs of NAS msg (0x0024 / 0x004e); returns the new length */
+static uint32_t
+split_strip(const uint8_t *f, uint32_t n, unsigned msg, uint8_t *o)
+{
+	const uint8_t *ids = msg == 0x0024 ? wh_ids_24 : wh_ids_4d;
+	int nids = msg == 0x0024 ? (int)sizeof(wh_ids_24) : (int)sizeof(wh_ids_4d);
+	uint32_t tn = (uint32_t)(f[11] | (f[12] << 8)), w = 13;
+	if (13 + tn > n) {
+		return 0;
+	}
+	memcpy(o, f, 13);
+	for (uint32_t k = 0; k + 3 <= tn;) {
+		uint32_t l = 3u + (uint32_t)(f[13 + k + 1] | (f[13 + k + 2] << 8));
+		if (k + l > tn) {
+			return 0;
+		}
+		int drop = 0;
+		for (int j = 0; j < nids; j++) {
+			drop |= ids[j] == f[13 + k];
+		}
+		if (!drop) {
+			memcpy(o + w, f + 13 + k, l);
+			w += l;
+		}
+		k += l;
+	}
+	o[11] = (uint8_t)(w - 13);
+	o[12] = (uint8_t)((w - 13) >> 8);
+	o[1] = (uint8_t)(w - 1);
+	o[2] = (uint8_t)((w - 1) >> 8);
+	return w;
+}
+
+static int
+split_release(void)
+{
+	int ok = 0, sent = 0, held = 0;
+	for (int i = 0; i < nhold; i++) {
+		struct hold *h = &B->holdq[i];
+		uint32_t l = 0, tn = (uint32_t)(h->f[11] | (h->f[12] << 8));
+		if (h->svc != 0x03 || 13 + tn > h->n) {
+			continue;
+		}
+		const uint8_t *v = h->msg == 0x0024 ? tlv_find(h->f + 13, tn, 0x01, &l) : h->msg == 0x004e ? tlv_find(h->f + 13, tn,
+		    0x14, &l) : NULL;
+		if (v && ((h->msg == 0x0024 && l >= 3 && v[2] == 1) || (h->msg == 0x004e && l >= 1 && v[0] == 2))) {
+			ok = 1;
+		}
+	}
+	if (!ok || split_ms <= 0) {
+		printf("SWEET QMUX: republish: split: not done (%s): plain release\n", split_ms <= 0 ? "kern.sweet_qmi_split_ms <= 0" :
+		    "no held NAS 0x0024 with PS attached and no held 0x004e with LTE service full");
+		return hold_release(nhold, "gate open (no split)");
+	}
+	spl.n = 0;
+	for (int i = 0; i < nhold; i++) {
+		struct hold *h = &B->holdq[i];
+		if (!cid_live(h->pipe, h->sess, h->svc, h->cid)) {
+			held_drop++;
+			continue;
+		}
+		if (h->svc == 0x03 && (h->msg == 0x0024 || h->msg == 0x004e) && spl.n < SPLIT_N) {
+			uint32_t w = split_strip(h->f, h->n, h->msg, spl_buf);
+			if (w) {
+				char a[96], b[96];
+				tlv_idlist(a, sizeof(a), spl_buf + 13, w - 13);
+				tlv_idlist(b, sizeof(b), h->f + 13, h->n - 13);
+				send_to(h->pipe, h->sess, spl_buf, w);
+				printf("SWEET QMUX: republish: split 1/2 (no PLMN) sent: NAS 0x%04x cid %u TLVs %s (modem's: %s)\n", h->msg, h->cid,
+				    a, b);
+				spl.q[spl.n].pipe = h->pipe;
+				spl.q[spl.n].sess = h->sess;
+				spl.q[spl.n].n = h->n;
+				memcpy(spl.q[spl.n].f, h->f, h->n);
+				spl.n++;
+				held++;
+				continue;
+			}
+		}
+		send_to(h->pipe, h->sess, h->f, h->n);
+		sent++;
+	}
+	nhold = 0;
+	spl.at = sbb_ms() + (uint64_t)split_ms;
+	printf("SWEET QMUX: republish: split: %d PLMN-carrying indication(s) sent without the PLMN, %d other(s) as they are; the "
+	    "full ones in %d ms\n", held, sent, split_ms);
+	return sent + held;
+}
+
+static void
+split_poll(uint64_t now)
+{
+	if (!spl.n || now < spl.at) {
+		return;
+	}
+	for (int i = 0; i < spl.n; i++) {
+		uint8_t *f = spl.q[i].f;
+		char a[96];
+		tlv_idlist(a, sizeof(a), f + 13, spl.q[i].n - 13);
+		if (cid_live(spl.q[i].pipe, spl.q[i].sess, f[4], f[5])) {
+			hold_bypass = 1;
+			send_to(spl.q[i].pipe, spl.q[i].sess, f, spl.q[i].n);
+			hold_bypass = 0;
+			printf("SWEET QMUX: republish: split 2/2 (full) sent: NAS 0x%04x cid %u TLVs %s\n", (unsigned)(f[9] | (f[10] << 8)),
+			    f[5], a);
+		}
+	}
+	spl.n = 0;
+}
+
 static void
 hold_poll(uint64_t now)
 {
+	split_poll(now);        /* 1094 */
 	uint64_t to = holdnas >= 100 ? (uint64_t)holdnas : 5000;
 	if (!nhold) {
 		return;
@@ -1665,8 +1809,8 @@ hold_poll(uint64_t now)
 		return;
 	}
 	if (hold_gate_open()) {
-		int k = hold_release(nhold, "gate open");
-		if (repub_mode == 4 && wh_start) {      /* 1087 */
+		int k = (repub_mode == 5 && wh_start) ? split_release() : hold_release(nhold, "gate open");     /* 1094 */
+		if ((repub_mode == 4 || repub_mode == 5) && wh_start) {      /* 1087 */
 			printf("SWEET QMUX: republish: PLMN withheld until activation (%u indication(s) held, %u answer(s) stripped/held)\n",
 			    wh_held, wh_stripped);
 			printf("SWEET QMUX: republish: released after activation: %d indication(s) delivered\n", k);
@@ -2084,7 +2228,7 @@ send_ind(uint32_t pipe, uint32_t sess, unsigned svc, unsigned cid, unsigned msg,
 		if (nhold) {
