+static int
+qr_ioctl(dev_t d, u_long cmd, caddr_t data, __unused int flag, __unused proc_t p)
+{
+	unsigned s = (unsigned)minor(d);
+	if (s >= SBB_QR_NPORTS) {
+		return ENXIO;
+	}
+	struct sbb_qr_slot *sl = &qr_slots[s];
+	if (cmd == MQRTR_IOC_PORT) {
+		*(uint32_t *)(void *)data = sl->def_port;
+		return 0;
+	}
+	if (cmd == MQRTR_IOC_BIND) {
+		uint32_t port = *(uint32_t *)(void *)data;
+		lck_mtx_lock(&q_lock);
+		if (port == sl->def_port) {
+			lck_mtx_unlock(&q_lock);
+			return 0;
+		}
+		if (port == 0 || port == SBB_PORT_CTRL || port_kernel_reserved(port)) {
+			sl->chan.refused++;
+			lck_mtx_unlock(&q_lock);
+			return EPERM;
+		}
+		int owner = qr_owner_locked(port);
+		if (owner == (int)s) {
+			lck_mtx_unlock(&q_lock);
+			return 0;
+		}
+		if (owner >= 0) {
+			lck_mtx_unlock(&q_lock);
+			return EADDRINUSE;
 		}
+		if (sl->nbinds >= SBB_QR_MAX_BINDS) {
+			lck_mtx_unlock(&q_lock);
+			return ENOSPC;
+		}
+		sl->binds[sl->nbinds++] = port;
 		lck_mtx_unlock(&q_lock);
+		return 0;
 	}
-	return ready;
+	if (cmd == MQRTR_IOC_UNBIND) {
+		uint32_t port = *(uint32_t *)(void *)data;
+		if (port == sl->def_port) {
+			return EINVAL;
+		}
+		struct sbb_qr_srv psrvs[SBB_QR_MAX_BINDS];
+		unsigned nps = 0;
+		int idx = -1;
+		lck_mtx_lock(&q_lock);
+		for (uint32_t i = 0; i < sl->nbinds; i++) {
+			if (sl->binds[i] == port) {
+				idx = (int)i;
+				break;
+			}
+		}
+		if (idx < 0) {
+			lck_mtx_unlock(&q_lock);
+			return ENOENT;
+		}
+		sl->binds[idx] = sl->binds[--sl->nbinds];
+		for (unsigned i = 0; i < SBB_QR_MAX_BINDS; i++) {
+			if (sl->srvs[i].used && sl->srvs[i].port == port) {
+				psrvs[nps++] = sl->srvs[i];
+				sl->srvs[i].used = false;
+			}
+		}
+		lck_mtx_unlock(&q_lock);
+		sl->delcl += qr_teardown_port(port, psrvs, nps, (int)s);
+		return 0;
+	}
+	if (cmd == MQRTR_IOC_LOOKUP) {
+		struct sbb_qrtr_lookup *lk = (struct sbb_qrtr_lookup *)(void *)data;
+		int best = -1;
+		lck_mtx_lock(&ml_lock);
+		for (int i = 0; i < NSRV; i++) {
+			if (srv[i].up && srv[i].svc == lk->svc && srv[i].inst == lk->inst) {
+				best = i;
+				break;
+			}
+		}
+		if (best < 0) {
+			for (int i = 0; i < NSRV; i++) {
+				if (srv[i].up && srv[i].svc == lk->svc &&
+				    (lk->inst == 0 || lk->inst == 0xffffffffu || (srv[i].inst >> 8) == lk->inst)) {
+					best = i;
+					break;
+				}
+			}
+		}
+		if (best >= 0) {
+			lk->inst = srv[best].inst;
+			lk->node = srv[best].node;
+			lk->port = srv[best].port;
+			lck_mtx_unlock(&ml_lock);
+			return 0;
+		}
+		lk->node = 0;
+		lk->port = 0;
+		lck_mtx_unlock(&ml_lock);
+		return ENOENT;
+	}
+	return ENOTTY;
+}
+
+static int
+qr_select(dev_t d, int which, void *wql, proc_t p)
+{
+	unsigned s = (unsigned)minor(d);
+	if (s >= SBB_QR_NPORTS) {
+		return 1;
+	}
+	return chan_select(&qr_slots[s].chan, which, wql, p);
 }
 
