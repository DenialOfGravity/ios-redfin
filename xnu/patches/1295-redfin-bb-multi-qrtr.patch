+			lck_mtx_unlock(&q_lock);
+			if (aux_ok) {
+				chan_deliver(&chan_aux, &lh, b, len);
+			} else {
+				e = ECONNREFUSED;
+			}
+		} else {
+			int dst = qr_owner_port(h.dst_port);
+			if (dst >= 0) {
+				chan_deliver(&qr_slots[dst].chan, &lh, b, len);
+				if (h.type == SBB_QRTR_DATA && h.confirm_rx) {
+					uint32_t rt[5] = { SBB_QRTR_RESUME_TX, SBB_NODE_APPS, h.dst_port, 0, 0 };
+					struct sbb_qrtr_hdr rh = { 1, SBB_QRTR_RESUME_TX, SBB_NODE_APPS, h.dst_port, 0, 20,
+					    SBB_NODE_APPS, h.src_port };
+					chan_deliver(&sl->chan, &rh, (const uint8_t *)rt, sizeof(rt));
+				}
+			} else if (!port_kernel_reserved(h.dst_port)) {
+				lck_mtx_lock(&q_lock);
+				bool w_ok = chan_wland.open;
+				lck_mtx_unlock(&q_lock);
+				if (w_ok) {
+					chan_deliver(&chan_wland, &lh, b, len);
+				} else {
+					e = ECONNREFUSED;
+				}
+			} else {
+				e = ECONNREFUSED;
+			}
+		}
+	} else {
+		e = qrtr_send_hdr(&h, b, len);
+		if (e == 0 && h.type == SBB_QRTR_DATA && h.src_port == sl->def_port) {
+			lck_mtx_lock(&q_lock);
+			sl->def_used = true;
+			lck_mtx_unlock(&q_lock);
+		}
+	}
+
+out:
+	if (b) {
+		kfree_data(b, rest);
+	}
+	if (e == 0) {
+		sl->chan.writes++;
+		sl->chan.write_bytes += len;
+	}
+	return e;
+}
