+static int
+qr_clone(__unused dev_t dev, int action)
+{
+	if (action != DEVFS_CLONE_ALLOC) {
+		return 0;
+	}
+	uint32_t start = (os_atomic_inc(&qr_next, relaxed) - 1u) % SBB_QR_NPORTS;
+	for (unsigned i = 0; i < SBB_QR_NPORTS; i++) {
+		unsigned s = (start + i) % SBB_QR_NPORTS;
