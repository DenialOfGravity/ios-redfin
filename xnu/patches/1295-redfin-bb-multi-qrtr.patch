+	chan_broadcast_ctrl(&ch, (const uint8_t *)cw, sizeof(cw), skip_slot);
+	if (gl.state == 2 && sbb_qrtr_send(SBB_QRTR_DEL_CLIENT, port, SBB_NODE_BCAST, SBB_PORT_CTRL, cw, sizeof(cw)) == 0) {
