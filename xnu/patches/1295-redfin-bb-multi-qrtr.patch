+		chan_broadcast_ctrl(&dh, (const uint8_t *)dw, sizeof(dw), skip_slot);
+		if (gl.state == 2) {
+			(void)sbb_qrtr_send(SBB_QRTR_DEL_SERVER, SBB_PORT_CTRL, SBB_NODE_MODEM, SBB_PORT_CTRL, dw, sizeof(dw));
+		}
