+/* never hold q_lock when calling */
+static unsigned
+qr_teardown_port(uint32_t port, const struct sbb_qr_srv *srvs, unsigned nsrvs, int skip_slot)
+{
+	for (unsigned i = 0; i < nsrvs; i++) {
+		lck_mtx_lock(&ml_lock);
