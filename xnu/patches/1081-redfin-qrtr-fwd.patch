+/*
+ * redfin 1081: QRTR forwarding between the modem (MPSS, sweet_bb.c) and the audio DSP (ADSP, sweet_adsp.c) through
+ * our kernel, as Linux net/qrtr/qrtr.c does between two remote nodes (qrtr_fwd_ctrl_pkt / qrtr_fwd_pkt). Default off:
+ * kern.sweet_qrtr_fwd. See sweet_qfwd.c.
+ */
+#ifndef _SWEET_QFWD_H_
+#define _SWEET_QFWD_H_
+#include <stdint.h>
+#include <stdbool.h>
+
+#define SWEET_QFWD_MODEM        0u
+#define SWEET_QFWD_ADSP         1u
+
+/* sweet_qfwd.c */
+void sweet_qfwd_init(uint32_t sweetbb);
+/*
+ * Every QRTR packet a remote sends us, before the link's own handling (sweet_bb.c qrtr_in with ml_lock held,
+ * sweet_adsp.c qrtr_input on its link thread). Never sleeps, never sends: it notes servers/HELLO/BYE and queues.
+ * true: the packet was for the other remote (DATA / RESUME_TX to its node) and is the forwarder's now; the caller
+ * must not handle it. Control packets are always handed back (false): local clients see what they saw before.
+ */
+bool sweet_qfwd_rx(unsigned side, uint32_t type, uint32_t src_node, uint32_t src_port, uint32_t confirm, uint32_t dst_node,
+    uint32_t dst_port, const uint8_t *payload, uint32_t len);
+/* a link went down (the modem link remade, the DSP's link stopped) */
+void sweet_qfwd_link_down(unsigned side);
+
+/* sweet_bb.c: one QRTR packet to the modem with the given source node (not ours) */
+int sbb_qrtr_send_as(uint32_t type, uint32_t src_node, uint32_t src_port, uint32_t confirm, uint32_t dst_node, uint32_t dst_port,
+    const void *data, uint32_t len);
+/* sweet_adsp.c: the same to the audio DSP */
+int redwood_qrtr_send_as(uint32_t type, uint32_t from_node, uint32_t from_port, uint32_t confirm, uint32_t to_node, uint32_t to_port,
+    const void *data, uint32_t length);
+#endif
