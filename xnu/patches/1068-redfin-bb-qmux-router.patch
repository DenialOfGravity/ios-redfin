+
+static const uint8_t *
+parse_hex(const char *h, uint16_t *len)
+{
+	uint8_t *start = pol_data + pol_dlen;
+	uint32_t n = 0;
+	int hi = -1;
+	for (; *h; h++) {
+		int v;
+		if (*h == '.' || *h == '_' || *h == ':') {
+			continue;
+		}
+		v = hexval(*h);
+		if (v < 0) {
+			return NULL;
+		}
+		if (hi < 0) {
+			hi = v;
+			continue;
+		}
+		if (pol_dlen + n >= sizeof(pol_data)) {
+			return NULL;
+		}
+		start[n++] = (uint8_t)(hi << 4 | v);
+		hi = -1;
+	}
+	if (hi >= 0 || n > 4096) {
+		return NULL;
+	}
+	pol_dlen += n;
+	*len = (uint16_t)n;
+	return start;
+}
+
+static int
+tlvs_ok(const uint8_t *p, uint32_t n)
+{
+	while (n) {
+		if (n < 3) {
+			return 0;
+		}
+		uint32_t l = (uint32_t)(p[1] | (p[2] << 8));
+		if (l > n - 3) {
+			return 0;
+		}
+		p += 3 + l;
+		n -= 3 + l;
+	}
+	return 1;
+}
