+/* ---- small string helpers (no libc here) ---- */
+
+static int
+hexval(char c)
+{
+	if (c >= '0' && c <= '9') {
+		return c - '0';
+	}
+	if (c >= 'a' && c <= 'f') {
+		return c - 'a' + 10;
+	}
+	if (c >= 'A' && c <= 'F') {
+		return c - 'A' + 10;
+	}
+	return -1;
+}
+
+static bool
+is_space(char c)
 {
+	return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+/* a number, C style (0x.. hex, decimal, optional '-'), the whole string; 0 ok */
+static int
+parse_num(const char *s, int *v)
+{
+	long x = 0;
+	int neg = 0, digits = 0;
+	if (*s == '-') {
+		neg = 1;
+		s++;
+	}
+	if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+		s += 2;
+		for (; *s && hexval(*s) >= 0; s++, digits++) {
+			x = x * 16 + hexval(*s);
+			if (x > 0x7fffffffL) {
+				return -1;
+			}
+		}
+	} else {
+		for (; *s >= '0' && *s <= '9'; s++, digits++) {
+			x = x * 10 + (*s - '0');
+			if (x > 0x7fffffffL) {
+				return -1;
+			}
+		}
+	}
+	if (!digits || *s) {
+		return -1;
+	}
+	*v = (int)(neg ? -x : x);
+	return 0;
+}
+
+/* leading decimal digits of s: value and how many characters; -1 if none */
+static int
+dec_prefix(const char *s, int *v, int *k)
+{
+	long x = 0;
+	int n = 0;
+	for (; s[n] >= '0' && s[n] <= '9'; n++) {
+		x = x * 10 + (s[n] - '0');
+		if (x > 0x7fffffffL) {
+			return -1;
+		}
+	}
+	if (!n) {
+		return -1;
+	}
+	*v = (int)x;
+	*k = n;
+	return 0;
+}
+
+/* leading hex digits of s (no 0x) */
+static int
+hex_prefix(const char *s, unsigned *v, int *k)
+{
+	unsigned x = 0;
+	int n = 0;
+	for (; hexval(s[n]) >= 0 && n < 8; n++) {
+		x = x * 16 + (unsigned)hexval(s[n]);
+	}
+	if (!n) {
+		return -1;
+	}
+	*v = x;
+	*k = n;
+	return 0;
+}
+
+/* up to max whitespace-separated words of line, each cut to wl-1 chars; the count */
+static int
+split_words(const char *line, char (*w)[256], int max)
+{
+	int n = 0;
+	const char *p = line;
+	while (n < max) {
+		while (*p && is_space(*p)) {
+			p++;
+		}
+		if (!*p) {
+			break;
+		}
+		int k = 0;
+		while (*p && !is_space(*p)) {
+			if (k < 255) {
+				w[n][k++] = *p;
+			}
+			p++;
+		}
+		w[n][k] = 0;
+		n++;
+	}
+	return n;
+}
+
+static const char *
+find_str(const char *s, const char *what)
+{
+	return strnstr(s, what, strlen(s) + 1);
+}
