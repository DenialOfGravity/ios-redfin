+/// sweet 0163: bytes from which a texture's texels are sampled: at most this much is hashed whole.
+const CACHE_WHOLE_BYTES: u64 = 256 * 1024;
+/// sweet 0163: writes by commands, per slot a key hashes to. A shared slot costs a needless copy only.
+static CACHE_WRITES: [AtomicU64; 4096] = [const { AtomicU64::new(0) }; 4096];
+/// sweet 0163: work recorded apart from the encoders' commands (`ShadowSync::leave`), which may
+/// write anything.
+static CACHE_LEFT: AtomicU64 = AtomicU64::new(0);
+static CACHE_COPIES: AtomicU64 = AtomicU64::new(0);
+static CACHE_SKIPPED: AtomicU64 = AtomicU64::new(0);
+static CACHE_HASHED: AtomicU64 = AtomicU64::new(0);
+static CACHE_HASH_US: AtomicU64 = AtomicU64::new(0);
+
+fn cache_slot(key: ResourceKey) -> &'static AtomicU64 {
+    let mut hasher = KeyHasher::default();
+    key.hash(&mut hasher);
+    &CACHE_WRITES[hasher.finish() as usize % CACHE_WRITES.len()]
+}
+
+/// sweet 0163: a command wrote `key`, perhaps not yet run: what a hash of its bytes says no
+/// longer counts.
+fn cache_written(key: ResourceKey) {
+    cache_slot(key).fetch_add(1, Ordering::Relaxed);
+}
