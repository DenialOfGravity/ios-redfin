+/// sweet 0163: changes whenever a command wrote the truth or the shadow of `copies`.
+fn cache_stamp(copies: &ShadowCopies) -> u64 {
+    let read = |key: ResourceKey| cache_slot(key).load(Ordering::Relaxed);
+    let alias = copies.alias().map_or(0, read);
+    CACHE_LEFT
+        .load(Ordering::Relaxed)
+        .wrapping_add(read(copies.truth().0))
+        .wrapping_add(alias)
+        .wrapping_add(read(copies.shadow_key))
+}
