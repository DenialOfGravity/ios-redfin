+/// sweet 0163 (Yofuness ios-flame bridge 0116, `M2V_SHADOW_CACHE`): env `SWEET_SHADOW_CACHE`
+/// (or `M2V_SHADOW_CACHE`), read once. 0 or unset: every copy in, as before. 1: a color
+/// texture's copy in over a buffer is skipped while a hash of its source texels, taken as the
+/// copy is planned, matches the last copy's. 2: skipped after the first copy whatever the bytes
+/// hold (a ceiling test, stale content expected). Both copy where the encoder's command writes
+/// through the texture, the texture was written through or its truth written by a command
+/// (`cache_written`), or the buffer's pages moved. The hash sees the CPU's writes up to the moment
+/// it runs: one between then and the GPU's read shows only at the next use, and in a texture over
+/// 256 KB one outside the rows hashed not until those change. Independent of the frontend's
+/// SWEET_DEADFILL (any mode). Skips count as `skipped` in the frontend's `J copies` line.
+fn cache_mode() -> u8 {
+    static MODE: OnceLock<u8> = OnceLock::new();
+    *MODE.get_or_init(|| {
+        let var = std::env::var("SWEET_SHADOW_CACHE").or_else(|_| std::env::var("M2V_SHADOW_CACHE"));
+        let mode = match var.as_deref().map(str::trim) {
+            Ok("1") => 1,
+            Ok("2") => 2,
+            _ => 0,
+        };
+        if mode != 0 {
+            cache_line(&format!("SWEET_SHADOW_CACHE={mode}"));
+        }
+        mode
+    })
+}
