+impl ShadowCache {
+    /// The state of a shadow over `layout` of `buffer`, of `aspects`; `None` where the cache is
+    /// off, or for a depth or stencil image.
+    pub(super) fn over(
+        buffer: &Buffer,
+        layout: &BufferLayout,
+        aspects: vk::ImageAspectFlags,
+    ) -> Option<ShadowCache> {
+        (cache_mode() != 0 && aspects == vk::ImageAspectFlags::COLOR).then(|| ShadowCache {
+            buffer: buffer.downgrade(),
+            layout: *layout,
+            held: Mutex::new(None),
+        })
+    }
+
+    fn forget(&self) {
+        *self.held.lock().unwrap_or_else(PoisonError::into_inner) = None;
+    }
+
+    /// Whether the image still holds what a copy in would bring, for `mode`; else what it will
+    /// hold is noted, for the copy the caller then plans.
+    fn unchanged(&self, mode: u8, stamp: u64) -> bool {
+        let layout = &self.layout;
+        let base = self.buffer.upgrade().and_then(|buffer| {
+            // Pages detached from the buffer may be gone; a buffer with a host copy has its bytes
+            // where the CPU reads none.
+            if buffer.detached() || layout.end() > buffer.length() {
+                return None;
+            }
+            Some((buffer.device_contents()?, buffer))
+        });
+        let Some((contents, _buffer)) = base else {
+            self.forget();
+            return false;
+        };
+        // SAFETY: the bytes lie in the buffer's length, and `_buffer` keeps them.
+        let base = unsafe { contents.as_ptr().add(layout.offset as usize) };
+        let hash = match mode {
+            1 => {
+                let began = Instant::now();
+                // SAFETY: as above.
+                let (hash, bytes) = unsafe { cache_hash(base, layout) };
+                let took = began.elapsed().as_micros() as u64;
+                CACHE_HASHED.fetch_add(bytes, Ordering::Relaxed);
+                CACHE_HASH_US.fetch_add(took, Ordering::Relaxed);
+                hash
+            }
+            _ => 0,
+        };
+        let now = CacheHeld {
+            hash,
+            base: base as usize,
+            stamp,
+        };
+        let mut held = self.held.lock().unwrap_or_else(PoisonError::into_inner);
+        held.replace(now) == Some(now)
+    }
+}
