+/// sweet 0163: a hash of the texels from `base`, laid out as `layout` from its first byte, and
+/// the bytes it read: only rows, never the bytes between them, as a copy moves. Each slice's
+/// every row at up to [`CACHE_WHOLE_BYTES`] of source, else its first and last rows and every
+/// 16th.
+///
+/// # Safety
+///
+/// Every row of `layout` from `base` lies in mapped memory. A client may be writing it: a torn
+/// read gives a hash that differs, or one that matches what the row holds next.
+pub(super) unsafe fn cache_hash(base: *const u8, layout: &BufferLayout) -> (u64, u64) {
+    let whole = layout.row_pitch * layout.rows * layout.slices <= CACHE_WHOLE_BYTES;
+    let mut hasher = KeyHasher::default();
+    let mut bytes = 0;
+    for slice in 0..layout.slices {
+        for row in 0..layout.rows {
+            if !whole && row != 0 && row != layout.rows - 1 && !row.is_multiple_of(16) {
+                continue;
+            }
+            let at = slice * layout.slice_pitch + row * layout.row_pitch;
+            // SAFETY: the caller's contract.
+            let texels = unsafe {
+                std::slice::from_raw_parts(base.add(at as usize), layout.row_bytes as usize)
+            };
+            hasher.write(texels);
+            bytes += layout.row_bytes;
+        }
+    }
+    (hasher.finish(), bytes)
+}
