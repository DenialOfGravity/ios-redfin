+/// sweet 0164 (`SWEET_SPARE_IMAGES`, `memory.rs`): spare image blocks kept, taken for a new image
+/// (a `vkAllocateMemory` saved), and freed; then the bytes of each.
+pub(crate) const SPARE_KEPT: usize = 0;
+pub(crate) const SPARE_TAKEN: usize = 1;
+pub(crate) const SPARE_FREED: usize = 2;
+static SPARE: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+
+/// sweet 0164: a spare block of `bytes` kept, taken or freed (`what`).
+pub(crate) fn spare_event(what: usize, bytes: u64) {
+    SPARE[what].fetch_add(1, Ordering::Relaxed);
+    SPARE[3 + what].fetch_add(bytes, Ordering::Relaxed);
+}
+
+/// sweet 0164: since the process started: spare blocks kept, taken, freed, and their bytes (in
+/// that order). Held now: kept bytes - taken bytes - freed bytes.
+pub fn spare_snapshot() -> [u64; 6] {
+    std::array::from_fn(|i| SPARE[i].load(Ordering::Relaxed))
+}
