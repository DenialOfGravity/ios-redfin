+pub(crate) mod spare_knobs {
+    use std::sync::OnceLock;
+    use std::time::Duration;
+    fn num(name: &str, default: u64) -> u64 {
+        std::env::var(name)
+            .ok()
+            .and_then(|v| v.trim().parse().ok())
+            .unwrap_or(default)
+    }
+    /// `SWEET_SPARE_IMAGES` set and not 0.
+    pub(crate) fn on() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| num("SWEET_SPARE_IMAGES", 0) != 0)
+    }
+    /// How long a spare stays unused before it is freed.
+    pub(crate) fn spare_for() -> Duration {
+        static MS: OnceLock<u64> = OnceLock::new();
+        Duration::from_millis(*MS.get_or_init(|| num("SWEET_SPARE_MS", 10_000)))
+    }
+    /// The bytes all spares of the device may hold.
+    pub(crate) fn spare_bytes() -> u64 {
+        static BYTES: OnceLock<u64> = OnceLock::new();
+        *BYTES.get_or_init(|| num("SWEET_SPARE_MB", 256).saturating_mul(1 << 20))
+    }
+}
