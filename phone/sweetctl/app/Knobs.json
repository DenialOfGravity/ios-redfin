    "HM_DRAW_SKIP",
    "all"
   ],
   "desc": "Test only: skips every draw (screen content goes wrong). Then Apply."
  },
  {
   "id": "hm.drawskip.off",
   "title": "Metal: HM_DRAW_SKIP off (default)",
   "cmd": [
    "kv-del",
    "/var/local/hmetal/env",
    "HM_DRAW_SKIP"
   ],
   "desc": "Removes the line. Then Apply."
  },
