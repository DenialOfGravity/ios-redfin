  {
   "id": "hm.apply",
   "title": "Apply (restart backboardd)",
   "cmd": [
    "render"
   ],
   "desc": "Applies the Metal (hakios-metal) switches. SpringBoard and apps restart too."
  },
  {
   "id": "hm.drawskip.on",
   "title": "Metal: HM_DRAW_SKIP=all",
   "cmd": [
    "kv-set",
