    {
     "id": "timeline",
     "title": "Timeline accounting",
     "kind": "kv",
     "file": "/var/local/mtl2-env",
     "key": "SWEET_TIMELINE",
     "type": "bool",
     "unset": true,
     "effect": "render"
    },
    {
     "id": "prewarm",
     "title": "Pipeline prewarm",
     "kind": "kv",
     "file": "/var/local/mtl2-env",
     "key": "SWEET_PREWARM",
     "type": "enum",
     "unset": true,
     "effect": "render",
     "options": [
      {
       "v": 0,
       "t": "Off"
      },
      {
       "v": 1,
       "t": "At device creation"
      },
      {
       "v": 2,
       "t": "Idle priming"
      }
     ]
    },
    {
     "id": "mesacache",
     "title": "Mesa shader cache",
     "kind": "kv",
     "file": "/var/local/mtl2-env",
     "key": "SWEET_MESA_CACHE",
     "type": "bool",
     "unset": true,
     "effect": "render"
    },
    {
     "id": "encthread",
     "title": "Encode thread",
     "kind": "kv",
     "file": "/var/local/mtl2-env",
     "key": "SWEET_ENCTHREAD",
     "type": "bool",
     "unset": true,
     "effect": "render"
    },
    {
     "id": "renderpri",
     "title": "Render thread fixed priority",
     "kind": "kv",
     "file": "/var/local/mtl2-env",
     "key": "SWEET_RENDER_PRI",
     "type": "int",
     "min": 0,
     "max": 97,
     "step": 1,
     "unset": true,
     "effect": "render",
     "desc": "SCHED_RR priority. Unset = off."
    },
    {
     "id": "rtrot",
     "title": "Keep Metal's rotation answer",
     "kind": "kv",
     "file": "/var/local/mtl2-env",
     "key": "SWEET_RT_ROTATION",
     "type": "bool",
     "unset": true,
     "effect": "render"
    }
   ]
  },
  {
   "title": "Frame rate requests (SweetFPS)",
   "footer": "File /var/local/sweetfps 'MODE TARGET'. Read when a process starts: respring (apps on relaunch).",
   "knobs": [
    {
     "id": "fpsmode",
     "title": "Mode",
     "kind": "words",
     "file": "/var/local/sweetfps",
     "index": 0,
     "type": "bits",
     "unset": true,
     "effect": "respring",
     "bits": [
      {
       "b": 1,
       "t": "Log requests"
      },
      {
       "b": 2,
       "t": "Rewrite low requests to target"
      },
      {
       "b": 4,
       "t": "Also log to /var/tmp/sweetfps.log"
      },
      {
       "b": 8,
       "t": "Rewrite to default instead"
      }
     ]
    },
    {
     "id": "fpstarget",
     "title": "Target fps",
     "kind": "words",
     "file": "/var/local/sweetfps",
     "index": 1,
     "type": "int",
     "min": 30,
     "max": 120,
     "step": 1,
     "default": 90,
     "effect": "respring"
    }
   ]
  },
  {
   "title": "Status bar (SweetSB)",
   "footer": "Size flags: read when the status bar is built. Respring.",
   "knobs": [
