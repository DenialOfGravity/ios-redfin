  {
   "title": "Charging",
   "footer": "Kernel 1123. Pin a row (pin icon) so boot-apply sets it again 5 s after SpringBoard starts; until then the hardware default (USB 2.0 500 mA) applies. No live charger-state sysctl exists in 1123: the state is the 'SWEET CHG30:' klog line every 30 s.",
   "knobs": [
    {
     "id": "chg",
     "title": "USB charging control (1123)",
     "kind": "sysctl",
     "name": "kern.sweet_chg",
     "type": "bool",
     "default": 0,
     "effect": "live",
     "desc": "1: kernel sets the input limit by port type (DCP/CDP/QC/Type-C 1.5 A: 1500 mA), FCC <= ABL's. FV, watchdog, JEITA never touched. 0: all back to ABL values."
    },
    {
     "id": "chgsdp",
     "title": "USB 3 port (900 mA)",
